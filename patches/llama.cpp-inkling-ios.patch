+            }
+            float32x4_t bdmin = vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->dmin)), ap->d);
+            acc = vmlsq_f32(acc, vcvtq_f32_s32(msum), bdmin);
+
+            int32x4_t isum = vdupq_n_s32(0);
+            for (int j = 0; j < 2; ++j) {
+                const uint8_t * qp = b_ptr->qs + j * 128;
+                uint8x16_t q0 = vld1q_u8(qp +  0); uint8x16_t q1 = vld1q_u8(qp + 16);
+                uint8x16_t q2 = vld1q_u8(qp + 32); uint8x16_t q3 = vld1q_u8(qp + 48);
+                uint8x16_t q4 = vld1q_u8(qp + 64); uint8x16_t q5 = vld1q_u8(qp + 80);
+                uint8x16_t q6 = vld1q_u8(qp + 96); uint8x16_t q7 = vld1q_u8(qp + 112);
+                const int is_base = j * 8;
+                auto step_pair = [&](int t, uint8x16_t u0, uint8x16_t u1, uint8x16_t u2, uint8x16_t u3,
+                                            uint8x16_t v0, uint8x16_t v1, uint8x16_t v2, uint8x16_t v3) {
+                    const int is0 = is_base + 2 * t;
+                    const int is1 = is0 + 1;
+                    int8x16_t a0 = vld1q_s8(ap->qs + is0 * 16);
+                    int8x16_t a1 = vld1q_s8(ap->qs + is1 * 16);
+                    int32x4_t p0 = vdupq_n_s32(0);
+                    p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(u0), a0, 0);
+                    p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(u1), a0, 1);
+                    p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(u2), a0, 2);
+                    p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(u3), a0, 3);
+                    int32x4_t p1 = vdupq_n_s32(0);
+                    p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(v0), a1, 0);
+                    p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(v1), a1, 1);
+                    p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(v2), a1, 2);
+                    p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(v3), a1, 3);
+                    const uint8_t * s0 = b_ptr->scales + is0 * 4;
+                    const uint8_t * s1 = b_ptr->scales + is1 * 4;
+                    int32x4_t sc0 = { (int32_t)(s0[0] & 0xf), (int32_t)(s0[1] & 0xf), (int32_t)(s0[2] & 0xf), (int32_t)(s0[3] & 0xf) };
+                    int32x4_t sc1 = { (int32_t)(s1[0] & 0xf), (int32_t)(s1[1] & 0xf), (int32_t)(s1[2] & 0xf), (int32_t)(s1[3] & 0xf) };
+                    isum = vmlaq_s32(isum, p0, sc0);
+                    isum = vmlaq_s32(isum, p1, sc1);
+                };
+                step_pair(0, vandq_u8(q0, m3), vandq_u8(q1, m3), vandq_u8(q2, m3), vandq_u8(q3, m3),
+                             vandq_u8(q4, m3), vandq_u8(q5, m3), vandq_u8(q6, m3), vandq_u8(q7, m3));
+                step_pair(1, vandq_u8(vshrq_n_u8(q0, 2), m3), vandq_u8(vshrq_n_u8(q1, 2), m3),
+                             vandq_u8(vshrq_n_u8(q2, 2), m3), vandq_u8(vshrq_n_u8(q3, 2), m3),
+                             vandq_u8(vshrq_n_u8(q4, 2), m3), vandq_u8(vshrq_n_u8(q5, 2), m3),
+                             vandq_u8(vshrq_n_u8(q6, 2), m3), vandq_u8(vshrq_n_u8(q7, 2), m3));
+                step_pair(2, vandq_u8(vshrq_n_u8(q0, 4), m3), vandq_u8(vshrq_n_u8(q1, 4), m3),
+                             vandq_u8(vshrq_n_u8(q2, 4), m3), vandq_u8(vshrq_n_u8(q3, 4), m3),
+                             vandq_u8(vshrq_n_u8(q4, 4), m3), vandq_u8(vshrq_n_u8(q5, 4), m3),
+                             vandq_u8(vshrq_n_u8(q6, 4), m3), vandq_u8(vshrq_n_u8(q7, 4), m3));
+                step_pair(3, vshrq_n_u8(q0, 6), vshrq_n_u8(q1, 6), vshrq_n_u8(q2, 6), vshrq_n_u8(q3, 6),
+                             vshrq_n_u8(q4, 6), vshrq_n_u8(q5, 6), vshrq_n_u8(q6, 6), vshrq_n_u8(q7, 6));
+            }
+            float32x4_t bd = vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->d)), ap->d);
+            acc = vfmaq_f32(acc, vcvtq_f32_s32(isum), bd);
+            b_ptr++;
+        }
+        vst1q_f32(s + c, acc);
+    }
