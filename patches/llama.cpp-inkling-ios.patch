+                const uint16x8_t sl_a_lo = vmovl_u8(vget_low_u8(sl[j * 2 + 0]));
+                const uint16x8_t sl_a_hi = vmovl_u8(vget_high_u8(sl[j * 2 + 0]));
+                const uint16x8_t sl_b_lo = vmovl_u8(vget_low_u8(sl[j * 2 + 1]));
