+                float32x4_t d = vmulq_n_f32(bd, ad[k0 + k]);
+                acc0 = vfmaq_f32(acc0, vcvtq_f32_s32(p0), d);
+                acc1 = vfmaq_f32(acc1, vcvtq_f32_s32(p1), d);
+                acc2 = vfmaq_f32(acc2, vcvtq_f32_s32(p2), d);
+                acc3 = vfmaq_f32(acc3, vcvtq_f32_s32(p3), d);
+            }
+            b_ptr++;
+        }
+        vst1q_f32(s + c, vaddq_f32(vaddq_f32(acc0, acc1), vaddq_f32(acc2, acc3)));
