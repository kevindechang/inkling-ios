+            const int k0 = 2 * b;
+            for (int k = 0; k < 2; ++k) {
+                const block_q8_0 * ap = &a_base[k0 + k];
+                const int32x4_t na = neg_asums[k0 + k];
+                uint8x16_t b0 = vld1q_u8(b_ptr->qs + k * 32 + 0);
+                uint8x16_t b1 = vld1q_u8(b_ptr->qs + k * 32 + 16);
+                int8x16_t a0 = vld1q_s8(ap->qs + 0);
+                int8x16_t a1 = vld1q_s8(ap->qs + 16);
+                int32x4_t p0 = vdupq_laneq_s32(na, 0);
+                int32x4_t p1 = vdupq_laneq_s32(na, 1);
+                int32x4_t p2 = vdupq_laneq_s32(na, 2);
+                int32x4_t p3 = vdupq_laneq_s32(na, 3);
+                p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(vandq_u8(b0, m3)), a0, 0);
+                b0 = vshrq_n_u8(b0, 2);
+                p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(vandq_u8(b0, m3)), a0, 1);
+                b0 = vshrq_n_u8(b0, 2);
+                p2 = vdotq_laneq_s32(p2, vreinterpretq_s8_u8(vandq_u8(b0, m3)), a0, 2);
+                p3 = vdotq_laneq_s32(p3, vreinterpretq_s8_u8(vshrq_n_u8(b0, 2)), a0, 3);
+
+                p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(vandq_u8(b1, m3)), a1, 0);
+                b1 = vshrq_n_u8(b1, 2);
+                p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(vandq_u8(b1, m3)), a1, 1);
+                b1 = vshrq_n_u8(b1, 2);
+                p2 = vdotq_laneq_s32(p2, vreinterpretq_s8_u8(vandq_u8(b1, m3)), a1, 2);
+                p3 = vdotq_laneq_s32(p3, vreinterpretq_s8_u8(vshrq_n_u8(b1, 2)), a1, 3);
