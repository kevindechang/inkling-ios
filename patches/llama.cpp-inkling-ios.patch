+void ggml_arm_gemv_iq2_4x4_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    static const int8_t iq2_nib_vals[16] = { 8, 25, 43, 0, -8, -25, -43, 0, 0, 0, 0, 0, 0, 0, 0, 0 };
+    const int nb = n / QK_K;
+    const block_iq2_4x4 * b_ptr = (const block_iq2_4x4 *) vx;
+    const block_q8_K * a_base = (const block_q8_K *) vy;
+    const int8x16_t kvals = vld1q_s8(iq2_nib_vals);
+    const uint8x16_t m4b = vdupq_n_u8(0x0f);
+    for (int c = 0; c < nc; c += 4) {
+        float32x4_t acc = vdupq_n_f32(0.0f);
+        for (int b = 0; b < nb; ++b) {
+            const block_q8_K * ap = &a_base[b];
+            int32x4_t sumi = vdupq_n_s32(0);
+            for (int ib32 = 0; ib32 < 8; ++ib32) {
+                const uint8_t * sp = b_ptr->scales + ib32 * 4;
+                int32x4_t sc_lo = { 1 + 2*(sp[0] & 0xf), 1 + 2*(sp[1] & 0xf), 1 + 2*(sp[2] & 0xf), 1 + 2*(sp[3] & 0xf) };
+                int32x4_t sc_hi = { 1 + 2*(sp[0] >>  4), 1 + 2*(sp[1] >>  4), 1 + 2*(sp[2] >>  4), 1 + 2*(sp[3] >>  4) };
+                for (int h = 0; h < 2; ++h) {
+                    const int sb = ib32 * 2 + h;
+                    int8x16_t a_sb = vld1q_s8(ap->qs + sb * 16);
+                    uint8x16_t b0 = vld1q_u8(b_ptr->qs + sb * 32 + 0);
+                    uint8x16_t b1 = vld1q_u8(b_ptr->qs + sb * 32 + 16);
+                    int32x4_t p = vdupq_n_s32(0);
+                    p = vdotq_laneq_s32(p, vqtbl1q_s8(kvals, vandq_u8(b0, m4b)), a_sb, 0);
+                    p = vdotq_laneq_s32(p, vqtbl1q_s8(kvals, vandq_u8(b1, m4b)), a_sb, 1);
+                    p = vdotq_laneq_s32(p, vqtbl1q_s8(kvals, vshrq_n_u8(b0, 4)), a_sb, 2);
+                    p = vdotq_laneq_s32(p, vqtbl1q_s8(kvals, vshrq_n_u8(b1, 4)), a_sb, 3);
+                    sumi = vmlaq_s32(sumi, p, h == 0 ? sc_lo : sc_hi);
+                }
+            }
+            float32x4_t d = vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->d)), ap->d);
+            acc = vfmaq_f32(acc, d, vcvtq_f32_s32(sumi));
+            b_ptr++;
+        }
+        vst1q_f32(s + c, vmulq_n_f32(acc, 0.125f));
+    }
+}
