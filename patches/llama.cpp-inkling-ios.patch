diff --git a/ggml/src/ggml-cpu/arch/arm/repack.cpp b/ggml/src/ggml-cpu/arch/arm/repack.cpp
index b60eff9..d9413c3 100644
--- a/ggml/src/ggml-cpu/arch/arm/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/repack.cpp
@@ -5769,3 +5769,626 @@ void ggml_gemm_q1_0_4x8_q8_0(int                        n,
 
     ggml_gemm_q1_0_4x8_q8_0_generic(n, s, bs, vx, vy, nr, nc);
 }
+
+// mmid expert cache 4x4 ARM NEON repack + gemv kernels (Q2_0, NVFP4, Q2_K, IQ1_S, IQ2_S/XS/XXS)
+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+#include <mutex>
+
+namespace {
+struct pair_u32 { uint32_t lo4; uint32_t hi4; };
+
+static uint32_t g_q2_0_lut[256];
+static pair_u32 g_iq1s_lut[NGRID_IQ1S];
+static pair_u32 g_iq2s_lut[1024];
+static pair_u32 g_iq2xs_lut[512];
+static pair_u32 g_iq2xxs_lut[256];
+static pair_u32 g_byte_sgn_lut[256];
+static pair_u32 g_keven_sgn_lut[128];
+static std::once_flag g_mmid_lut_once;
+
+static inline uint8_t iq2_mag_code(uint8_t v) {
+    return v == 8 ? 0 : (v == 25 ? 1 : 2);
+}
+
+static void init_mmid_repack_luts() {
+    std::call_once(g_mmid_lut_once, []() {
+        for (int b = 0; b < 256; ++b) {
+            uint32_t w0 = (uint32_t) ((b >> 0) & 3);
+            uint32_t w1 = (uint32_t) ((b >> 2) & 3);
+            uint32_t w2 = (uint32_t) ((b >> 4) & 3);
+            uint32_t w3 = (uint32_t) ((b >> 6) & 3);
+            g_q2_0_lut[b] = w0 | (w1 << 8) | (w2 << 16) | (w3 << 24);
+
+            uint32_t slo = 0, shi = 0;
+            for (int j = 0; j < 4; ++j) {
+                if (b & (1 << j))       { slo |= (0x04u << (8 * j)); }
+                if (b & (1 << (j + 4))) { shi |= (0x04u << (8 * j)); }
+            }
+            g_byte_sgn_lut[b] = { slo, shi };
+        }
+        for (int i = 0; i < NGRID_IQ1S; ++i) {
+            const int8_t * g = (const int8_t *) (iq1s_grid + i);
+            uint32_t lo = 0, hi = 0;
+            for (int j = 0; j < 4; ++j) {
+                lo |= ((uint32_t) (g[j]     + 1) << (8 * j));
+                hi |= ((uint32_t) (g[j + 4] + 1) << (8 * j));
+            }
+            g_iq1s_lut[i] = { lo, hi };
+        }
+        auto build_iq2 = [](const uint64_t * grid, int n, pair_u32 * out) {
+            for (int i = 0; i < n; ++i) {
+                const uint8_t * g = (const uint8_t *) (grid + i);
+                uint32_t lo = 0, hi = 0;
+                for (int j = 0; j < 4; ++j) {
+                    lo |= ((uint32_t) iq2_mag_code(g[j])     << (8 * j));
+                    hi |= ((uint32_t) iq2_mag_code(g[j + 4]) << (8 * j));
+                }
+                out[i] = { lo, hi };
+            }
+        };
+        build_iq2(iq2s_grid,   1024, g_iq2s_lut);
+        build_iq2(iq2xs_grid,   512, g_iq2xs_lut);
+        build_iq2(iq2xxs_grid,  256, g_iq2xxs_lut);
+        for (int i = 0; i < 128; ++i) {
+            uint8_t s = ksigns_iq2xs[i];
+            g_keven_sgn_lut[i] = g_byte_sgn_lut[s];
+        }
+    });
+}
+} // namespace
+
+extern "C" {
+
+bool ggml_arm_mmid_has_custom_kernels(void) {
+    return true;
+}
+
+void ggml_arm_repack_q2_0_4x4(void * GGML_RESTRICT dst_v, const void * GGML_RESTRICT src_v, int64_t ne0, int64_t ne1) {
+    init_mmid_repack_luts();
+    const int64_t nb = ne0 / QK2_0;
+    const block_q2_0 * src = (const block_q2_0 *) src_v;
+    block_q2_0x4 * dst = (block_q2_0x4 *) dst_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            block_q2_0x4 out;
+            for (int i = 0; i < 4; ++i) {
+                const block_q2_0 & in = src[(r + i) * nb + b];
+                out.d[i] = in.d;
+                for (int k = 0; k < 2; ++k) {
+                    const uint8_t * s = in.qs + k * 8;
+                    uint32_t v0 = g_q2_0_lut[s[0]] | (g_q2_0_lut[s[1]] << 2) | (g_q2_0_lut[s[2]] << 4) | (g_q2_0_lut[s[3]] << 6);
+                    uint32_t v1 = g_q2_0_lut[s[4]] | (g_q2_0_lut[s[5]] << 2) | (g_q2_0_lut[s[6]] << 4) | (g_q2_0_lut[s[7]] << 6);
+                    memcpy(out.qs + k * 32 + 0  + i * 4, &v0, 4);
+                    memcpy(out.qs + k * 32 + 16 + i * 4, &v1, 4);
+                }
+            }
+            *dst++ = out;
+        }
+    }
+}
+
+void ggml_arm_gemv_q2_0_4x4_q8_0(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    const int nb = n / QK2_0;
+    const block_q2_0x4 * b_ptr = (const block_q2_0x4 *) vx;
+    const block_q8_0 * a_base = (const block_q8_0 *) vy;
+    const uint8x16_t m3 = vdupq_n_u8(0x03);
+    const int8x16_t ones = vdupq_n_s8(1);
+    const int n_q8 = nb * 2;
+    int32_t asums_buf[1024 * 4];
+    int32_t * asums = n_q8 <= 1024 ? asums_buf : (int32_t *) malloc((size_t) n_q8 * 4 * sizeof(int32_t));
+    for (int k = 0; k < n_q8; ++k) {
+        int8x16_t a0 = vld1q_s8(a_base[k].qs);
+        int8x16_t a1 = vld1q_s8(a_base[k].qs + 16);
+        int32x4_t t = vdotq_s32(vdotq_s32(vdupq_n_s32(0), a0, ones), a1, ones);
+        vst1q_s32(asums + k * 4, t);
+    }
+    // Keep 4 per-quarter accumulators so float summation matches ggml_vec_dot_q2_0_q8_0 bit-for-bit.
+    for (int c = 0; c < nc; c += 4) {
+        float32x4_t acc0 = vdupq_n_f32(0.0f);
+        float32x4_t acc1 = vdupq_n_f32(0.0f);
+        float32x4_t acc2 = vdupq_n_f32(0.0f);
+        float32x4_t acc3 = vdupq_n_f32(0.0f);
+        for (int b = 0; b < nb; ++b) {
+            float32x4_t bd = vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->d));
+            for (int k = 0; k < 2; ++k) {
+                const block_q8_0 * ap = &a_base[2 * b + k];
+                const int32_t * as = asums + (2 * b + k) * 4;
+                uint8x16_t b0 = vld1q_u8(b_ptr->qs + k * 32 + 0);
+                uint8x16_t b1 = vld1q_u8(b_ptr->qs + k * 32 + 16);
+                int8x16_t a0 = vld1q_s8(ap->qs + 0);
+                int8x16_t a1 = vld1q_s8(ap->qs + 16);
+                int32x4_t p0 = vdupq_n_s32(-as[0]);
+                int32x4_t p1 = vdupq_n_s32(-as[1]);
+                int32x4_t p2 = vdupq_n_s32(-as[2]);
+                int32x4_t p3 = vdupq_n_s32(-as[3]);
+                p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(vandq_u8(b0, m3)),               a0, 0);
+                p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b0, 2), m3)), a0, 1);
+                p2 = vdotq_laneq_s32(p2, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b0, 4), m3)), a0, 2);
+                p3 = vdotq_laneq_s32(p3, vreinterpretq_s8_u8(vshrq_n_u8(b0, 6)),               a0, 3);
+                p0 = vdotq_laneq_s32(p0, vreinterpretq_s8_u8(vandq_u8(b1, m3)),               a1, 0);
+                p1 = vdotq_laneq_s32(p1, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b1, 2), m3)), a1, 1);
+                p2 = vdotq_laneq_s32(p2, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b1, 4), m3)), a1, 2);
+                p3 = vdotq_laneq_s32(p3, vreinterpretq_s8_u8(vshrq_n_u8(b1, 6)),               a1, 3);
+                float32x4_t d = vmulq_n_f32(bd, GGML_CPU_FP16_TO_FP32(ap->d));
+                acc0 = vmlaq_f32(acc0, vcvtq_f32_s32(p0), d);
+                acc1 = vmlaq_f32(acc1, vcvtq_f32_s32(p1), d);
+                acc2 = vmlaq_f32(acc2, vcvtq_f32_s32(p2), d);
+                acc3 = vmlaq_f32(acc3, vcvtq_f32_s32(p3), d);
+            }
+            b_ptr++;
+        }
+        vst1q_f32(s + c, vaddq_f32(vaddq_f32(acc0, acc1), vaddq_f32(acc2, acc3)));
+    }
+    if (asums != asums_buf) { free(asums); }
+}
+
+void ggml_arm_repack_nvfp4_4x4(void * GGML_RESTRICT dst_v, const void * GGML_RESTRICT src_v, int64_t ne0, int64_t ne1) {
+    const int64_t nb = ne0 / QK_NVFP4;
+    const block_nvfp4 * src = (const block_nvfp4 *) src_v;
+    block_nvfp4x4 * dst = (block_nvfp4x4 *) dst_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            block_nvfp4x4 out;
+            for (int i = 0; i < 4; ++i) {
+                const block_nvfp4 & in = src[(r + i) * nb + b];
+                for (int sb = 0; sb < 4; ++sb) {
+                    out.d[sb * 4 + i] = in.d[sb];
+                    memcpy(out.qs + sb * 32 + 0  + i * 4, in.qs + sb * 8 + 0, 4);
+                    memcpy(out.qs + sb * 32 + 16 + i * 4, in.qs + sb * 8 + 4, 4);
+                }
+            }
+            *dst++ = out;
+        }
+    }
+}
+
+void ggml_arm_gemv_nvfp4_4x4_q8_0(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    const int nb = n / QK_NVFP4;
+    const block_nvfp4x4 * b_ptr = (const block_nvfp4x4 *) vx;
+    const block_q8_0 * a_base = (const block_q8_0 *) vy;
+    const int8x16_t kvals = vld1q_s8(kvalues_mxfp4);
+    const uint8x16_t m4b = vdupq_n_u8(0x0f);
+    // Keep 4 per-subblock accumulators so float summation matches ggml_vec_dot_nvfp4_q8_0 bit-for-bit.
+    for (int c = 0; c < nc; c += 4) {
+        float32x4_t acc[4] = {
+            vdupq_n_f32(0.0f), vdupq_n_f32(0.0f), vdupq_n_f32(0.0f), vdupq_n_f32(0.0f)
+        };
+        for (int b = 0; b < nb; ++b) {
+            const float dy[2] = { GGML_CPU_FP16_TO_FP32(a_base[2 * b + 0].d), GGML_CPU_FP16_TO_FP32(a_base[2 * b + 1].d) };
+            for (int sb = 0; sb < 4; ++sb) {
+                const int8_t * qp = a_base[2 * b + (sb >> 1)].qs + (sb & 1) * 16;
+                int8x16_t a_sb = vld1q_s8(qp);
+                uint8x16_t b0 = vld1q_u8(b_ptr->qs + sb * 32 + 0);
+                uint8x16_t b1 = vld1q_u8(b_ptr->qs + sb * 32 + 16);
+                int32x4_t sumi = vdupq_n_s32(0);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b0, m4b)), a_sb, 0);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b1, m4b)), a_sb, 1);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b0, 4)), a_sb, 2);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b1, 4)), a_sb, 3);
+                const uint8_t * dp = b_ptr->d + sb * 4;
+                float32x4_t sc = {
+                    GGML_CPU_UE4M3_TO_FP32(dp[0]),
+                    GGML_CPU_UE4M3_TO_FP32(dp[1]),
+                    GGML_CPU_UE4M3_TO_FP32(dp[2]),
+                    GGML_CPU_UE4M3_TO_FP32(dp[3]),
+                };
+                acc[sb] = vfmaq_f32(acc[sb], vcvtq_f32_s32(sumi), vmulq_n_f32(sc, dy[sb >> 1]));
+            }
+            b_ptr++;
+        }
+        vst1q_f32(s + c, vaddq_f32(vaddq_f32(acc[0], acc[1]), vaddq_f32(acc[2], acc[3])));
+    }
+}
+
+void ggml_arm_gemv_mxfp4_4x4_q8_0_exact(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    const int nb = n / QK8_0;
+    const int8x16_t kvals = vld1q_s8(kvalues_mxfp4);
+    const uint8x16_t m4b = vdupq_n_u8(0x0f);
+    const block_q8_0 * a_ptr = (const block_q8_0 *) vy;
+    // Match ggml_vec_dot_mxfp4_q8_0 paired block accumulation bit-for-bit.
+    for (int x = 0; x < nc / 4; ++x) {
+        const block_mxfp4x4 * b_ptr = (const block_mxfp4x4 *) vx + x * nb;
+        float32x4_t sumf = vdupq_n_f32(0.0f);
+        int l = 0;
+        for (; l + 1 < nb; l += 2) {
+            auto blk_ds = [&](int idx, float32x4_t & out_d, float32x4_t & out_s) {
+                uint8x16_t b0 = vld1q_u8(b_ptr[idx].qs +  0);
+                uint8x16_t b1 = vld1q_u8(b_ptr[idx].qs + 16);
+                uint8x16_t b2 = vld1q_u8(b_ptr[idx].qs + 32);
+                uint8x16_t b3 = vld1q_u8(b_ptr[idx].qs + 48);
+                int8x16_t a0 = vld1q_s8(a_ptr[idx].qs +  0);
+                int8x16_t a1 = vld1q_s8(a_ptr[idx].qs + 16);
+                int32x4_t sumi = vdupq_n_s32(0);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b0, m4b)), a0, 0);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b0, 4)), a1, 0);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b1, m4b)), a0, 1);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b1, 4)), a1, 1);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b2, m4b)), a0, 2);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b2, 4)), a1, 2);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b3, m4b)), a0, 3);
+                sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b3, 4)), a1, 3);
+                float32x4_t bd = {
+                    GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[idx].e[0]),
+                    GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[idx].e[1]),
+                    GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[idx].e[2]),
+                    GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[idx].e[3]),
+                };
+                out_d = vmulq_n_f32(bd, GGML_CPU_FP16_TO_FP32(a_ptr[idx].d));
+                out_s = vcvtq_f32_s32(sumi);
+            };
+            float32x4_t d0, s0, d1, s1;
+            blk_ds(l + 0, d0, s0);
+            blk_ds(l + 1, d1, s1);
+            float32x4_t pair = vfmaq_f32(vmulq_f32(d1, s1), d0, s0);
+            sumf = vaddq_f32(sumf, pair);
+        }
+        for (; l < nb; ++l) {
+            uint8x16_t b0 = vld1q_u8(b_ptr[l].qs +  0);
+            uint8x16_t b1 = vld1q_u8(b_ptr[l].qs + 16);
+            uint8x16_t b2 = vld1q_u8(b_ptr[l].qs + 32);
+            uint8x16_t b3 = vld1q_u8(b_ptr[l].qs + 48);
+            int8x16_t a0 = vld1q_s8(a_ptr[l].qs +  0);
+            int8x16_t a1 = vld1q_s8(a_ptr[l].qs + 16);
+            int32x4_t sumi = vdupq_n_s32(0);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b0, m4b)), a0, 0);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b0, 4)), a1, 0);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b1, m4b)), a0, 1);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b1, 4)), a1, 1);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b2, m4b)), a0, 2);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b2, 4)), a1, 2);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vandq_u8(b3, m4b)), a0, 3);
+            sumi = vdotq_laneq_s32(sumi, vqtbl1q_s8(kvals, vshrq_n_u8(b3, 4)), a1, 3);
+            float32x4_t bd = {
+                GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[l].e[0]),
+                GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[l].e[1]),
+                GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[l].e[2]),
+                GGML_CPU_E8M0_TO_FP32_HALF(b_ptr[l].e[3]),
+            };
+            float32x4_t d = vmulq_n_f32(bd, GGML_CPU_FP16_TO_FP32(a_ptr[l].d));
+            sumf = vaddq_f32(sumf, vmulq_f32(d, vcvtq_f32_s32(sumi)));
+        }
+        vst1q_f32(s + x * 4, sumf);
+    }
