+        (double) atomic_load(&mmid_read_bytes) / 1048576.0, (unsigned long long) atomic_load(&mmid_read_calls), mmid_wait_us / 1000.0,
+        (unsigned long long) mmid_pf_issued, (unsigned long long) mmid_pf_used, (unsigned long long) mmid_pf_wasted, (unsigned long long) mmid_bypass_reads,
+        (unsigned long long) atomic_load(&mmid_repacked_slices), (double) atomic_load(&mmid_repack_us) / 1000.0,
+        (double) ggml_cpu_mmid_cecar_bonus(), (unsigned long long) atomic_load(&mmid_cecar_calls), (unsigned long long) atomic_load(&mmid_cecar_swaps));
+    fflush(stderr);
+}
+
+static void mmid_port_exit(void) {
+    if (mmid_io.n_threads) {
+        pthread_mutex_lock(&mmid_io.mu); mmid_io.stop = true; pthread_cond_broadcast(&mmid_io.work); pthread_mutex_unlock(&mmid_io.mu);
+        for (int i = 0; i < mmid_io.n_threads; i++) { pthread_join(mmid_io.threads[i], NULL); }
+        mmid_io.n_threads = 0;
+    }
+    ggml_cpu_mmid_stats_dump();
+}
