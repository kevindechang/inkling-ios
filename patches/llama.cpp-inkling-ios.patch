+static void ggml_compute_forward_situ_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    GGML_ASSERT(src1);
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous_1(src0));
+    GGML_ASSERT(ggml_is_contiguous_1(src1));
+    GGML_ASSERT(ggml_is_contiguous_1(dst));
+    GGML_ASSERT(ggml_are_same_shape(src0, src1));
+    GGML_ASSERT(ggml_are_same_shape(src0, dst));
+
+    const float beta = ggml_get_op_params_f32(dst, 2);
+    const float lb   = ggml_get_op_params_f32(dst, 3);
+    GGML_ASSERT(beta > 0.0f);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int nc = (int) src0->ne[0];
+    const int nr = (int) ggml_nrows(src0);
+    const int dr = (nr + nth - 1) / nth;
+    const int ir0 = dr * ith;
+    const int ir1 = MIN(ir0 + dr, nr);
+
+    const size_t nb0 = src0->nb[1];
+    const size_t nb1 = src1->nb[1];
+    const size_t nbd = dst->nb[1];
+
+    for (int i1 = ir0; i1 < ir1; ++i1) {
+        const float * g = (const float *) ((const char *) src0->data + (size_t) i1 * nb0);
+        const float * u = (const float *) ((const char *) src1->data + (size_t) i1 * nb1);
+        float * y = (float *) ((char *) dst->data + (size_t) i1 * nbd);
+        situ_row_f32(y, g, u, nc, beta, lb);
