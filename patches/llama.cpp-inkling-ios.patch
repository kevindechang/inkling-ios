+        if (!old) { break; }
+        mmid_cache_bytes -= old->size;
+        if (old->size == size && !buf) { buf = old->buf; } else { free(old->buf); }
+        old->buf = NULL;
+    }
+    if (!buf && posix_memalign((void **) &buf, 16384, size) != 0) { *out_repacked = false; return key; }
+    e->key = key; e->buf = buf; e->size = size;
+    e->file_size = file_size; e->ne0 = ne0; e->ne1 = ne1; e->src_type = type; e->repacked = do_repack;
+    mmid_cache_bytes += size;
+    mmid_pending[mmid_n_pending++] = e;
+    *out_repacked = do_repack;
+    return buf;
+}
+
+static void mmid_repack_from_raw(struct mmid_cache_entry * e, const char * raw) {
+    const int64_t t0 = mmid_stats_on ? ggml_time_us() : 0;
+    ggml_mmid_repack_slice(e->src_type, e->ne0, e->ne1, e->buf, raw, e->file_size);
+    if (mmid_stats_on) {
+        atomic_fetch_add(&mmid_repacked_slices, 1);
+        atomic_fetch_add(&mmid_repack_us, (unsigned long long) (ggml_time_us() - t0));
+    }
+}
+
+static void mmid_read_one_with_scratch(struct mmid_cache_entry * e, char ** scratch, size_t * scratch_cap) {
+    if (!e->repacked) {
+        if (!ggml_file_map_read(e->key, e->buf, e->file_size)) { memcpy(e->buf, e->key, e->file_size); }
+        if (mmid_stats_on) { atomic_fetch_add(&mmid_read_calls, 1); atomic_fetch_add(&mmid_read_bytes, e->file_size); }
+        return;
+    }
+    char * raw = NULL;
+    bool own_raw = false;
+    if (scratch && scratch_cap) {
+        if (*scratch_cap < e->file_size) {
+            char * nb = (char *) realloc(*scratch, e->file_size);
+            GGML_ASSERT(nb != NULL);
+            *scratch = nb;
+            *scratch_cap = e->file_size;
+        }
+        raw = *scratch;
+    } else {
+        raw = (char *) malloc(e->file_size);
+        GGML_ASSERT(raw != NULL);
+        own_raw = true;
+    }
+    if (!ggml_file_map_read(e->key, raw, e->file_size)) { memcpy(raw, e->key, e->file_size); }
+    if (mmid_stats_on) { atomic_fetch_add(&mmid_read_calls, 1); atomic_fetch_add(&mmid_read_bytes, e->file_size); }
+    mmid_repack_from_raw(e, raw);
+    if (own_raw) { free(raw); }
+}
+
+static void mmid_cache_fill_one(void * ctx, size_t i) {
+    (void) ctx;
+    mmid_read_one_with_scratch(mmid_pending[i], NULL, NULL);
+}
+
+static void mmid_cache_fill(void) {
+#if defined(__APPLE__)
+    if (mmid_n_pending > 1) {
+        dispatch_apply_f((size_t) mmid_n_pending, dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), NULL, mmid_cache_fill_one);
+        mmid_n_pending = 0;
+        return;
+    }
+#endif
+    for (int i = 0; i < mmid_n_pending; i++) { mmid_cache_fill_one(NULL, (size_t) i); }
+    mmid_n_pending = 0;
+}
+
+// Atomic Engine port (sage-lab, 2026-11-24; Atomic Engine is MIT). Each part is off by default, read once at init:
+//   GGML_MMID_OVERLAP=1   known-route overlap: the op's misses go to an urgent queue and the paired down slices to a low queue
+//                         of 2 reader threads; compute runs the resident experts first and waits only for its own misses
+//   GGML_MMID_LRU=1       O(1) LRU, one list per slice size so a victim's buffer is reused in place;  =2 ClassLRU
+//   GGML_MMID_COALESCE=1  one preadv for file-adjacent missing slices; in prefill ubatches of >= 512 tokens the slices not
+//                         used by the last row are read into a scratch buffer instead of the cache
+//   GGML_MMID_STATS=1     counters printed once at exit
+// Locking. The cache table, LRU lists, pins, history and scratch buffers are changed only by compute thread 0 in the
+// mul_mat_id prologue, while the other compute threads wait at the op barrier. An entry that is pinned or LOADING is never
+// evicted or reused. Reader threads touch only the entries of their own task: key, buf and size read-only, state written.
+// mmid_io.mu guards the queues, entry->task and the LOADING -> READY change (release store, broadcast on mmid_io.done);
+// compute threads load entry->state with acquire and sleep on mmid_io.done until READY. The pins of an op are dropped by
+// thread 0 at the next mul_mat_id, past the node barrier, when no compute thread still reads those buffers.
+#if defined(__APPLE__) || defined(__linux__)
+#define MMID_PORT 1
+#if defined(__APPLE__)
+#include <pthread/qos.h>
+#endif
+
+enum { MMID_EMPTY = 0, MMID_LOADING = 1, MMID_READY = 2 };
+#define MMID_GROUP_MAX  16   // Atomic Engine: <= 16 slices per batched read
+#define MMID_IO_THREADS 2   // reader threads; GGML_MMID_IO_THREADS=<1..8> overrides (THREAD_SCALING.md)
+#define MMID_IO_THREADS_MAX 8
+#define MMID_TASKS      1024
+#define MMID_LISTS      16   // LRU: one list per slice size; ClassLRU: 8 classes
+#define MMID_CLASSES    8
+#define MMID_TENSORS    128
+#define MMID_ALIGN      16384
+#define MMID_BYPASS_MIN_TOKENS 512
+
+static int mmid_overlap = 0, mmid_lru = 0, mmid_coalesce = 0;
+static uint64_t mmid_pf_issued = 0, mmid_pf_used = 0, mmid_pf_wasted = 0, mmid_bypass_reads = 0;
+
+static bool mmid_port_active(void) { return mmid_overlap || mmid_lru || mmid_coalesce; }
+
+// ---- reader threads: urgent and low queues, adapted from Atomic Engine src/llama-expert-read-pool.h (early_io::pool)
+struct mmid_task { struct mmid_task * next; struct mmid_cache_entry * e[MMID_GROUP_MAX]; int n; bool urgent, queued; };
+static struct {
+    pthread_mutex_t mu; pthread_cond_t work, done;
+    pthread_t threads[MMID_IO_THREADS_MAX]; int n_threads; bool stop;
+    struct mmid_task * high, * high_tail, * low, * low_tail, * free_list;
+    struct mmid_task tasks[MMID_TASKS];
+} mmid_io = { .mu = PTHREAD_MUTEX_INITIALIZER, .work = PTHREAD_COND_INITIALIZER, .done = PTHREAD_COND_INITIALIZER };
+
+static void mmid_append(struct mmid_task ** head, struct mmid_task ** tail, struct mmid_task * t) {
+    t->next = NULL; if (*tail) { (*tail)->next = t; } else { *head = t; } *tail = t;
+}
+static struct mmid_task * mmid_pop(struct mmid_task ** head, struct mmid_task ** tail) {
+    struct mmid_task * t = *head; *head = t->next; if (!*head) { *tail = NULL; } t->next = NULL; return t;
+}
+static void mmid_unlink(struct mmid_task ** head, struct mmid_task ** tail, struct mmid_task * t) {
+    struct mmid_task * prev = NULL;
+    for (struct mmid_task * p = *head; p; prev = p, p = p->next) {
+        if (p == t) { if (prev) { prev->next = p->next; } else { *head = p->next; } if (*tail == p) { *tail = prev; } p->next = NULL; return; }
+    }
+}
+
+// read a group of file-adjacent slices with one preadv (Atomic Engine src/llama-expert-source.cpp, adjacent layout)
+static void mmid_read_group(struct mmid_cache_entry * const * es, int n, char ** scratch, size_t * scratch_cap) {
+    size_t total = 0;
+    if (n > 1) {
+        void * dst[MMID_GROUP_MAX]; size_t size[MMID_GROUP_MAX];
+        for (int i = 0; i < n; i++) { dst[i] = es[i]->buf; size[i] = es[i]->file_size; total += size[i]; }
+        if (ggml_file_map_readv(es[0]->key, dst, size, n)) {
+            if (mmid_stats_on) { atomic_fetch_add(&mmid_read_calls, 1); atomic_fetch_add(&mmid_read_bytes, total); }
+            for (int i = 0; i < n; i++) {
+                if (!es[i]->repacked) { continue; }
+                char * raw = NULL;
+                bool own_raw = false;
+                if (scratch && scratch_cap) {
+                    if (*scratch_cap < es[i]->file_size) {
+                        char * nb = (char *) realloc(*scratch, es[i]->file_size);
+                        GGML_ASSERT(nb != NULL);
+                        *scratch = nb; *scratch_cap = es[i]->file_size;
+                    }
+                    raw = *scratch;
+                } else {
+                    raw = (char *) malloc(es[i]->file_size);
+                    GGML_ASSERT(raw != NULL);
+                    own_raw = true;
+                }
+                memcpy(raw, es[i]->buf, es[i]->file_size);
+                mmid_repack_from_raw(es[i], raw);
+                if (own_raw) { free(raw); }
+            }
+            return;
+        }
+    }
+    for (int i = 0; i < n; i++) {
+        mmid_read_one_with_scratch(es[i], scratch, scratch_cap);
+    }
+}
+
+static void * mmid_io_main(void * arg) {
+    (void) arg;
+#if defined(__APPLE__)
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INITIATED, 0);
+#endif
+    char * scratch = NULL;
+    size_t scratch_cap = 0;
+    pthread_mutex_lock(&mmid_io.mu);
+    for (;;) {
+        while (!mmid_io.stop && !mmid_io.high && !mmid_io.low) { pthread_cond_wait(&mmid_io.work, &mmid_io.mu); }
+        if (mmid_io.stop) { break; } // at exit no op waits: queued reads are dropped
+        struct mmid_task * t = mmid_io.high ? mmid_pop(&mmid_io.high, &mmid_io.high_tail) : mmid_pop(&mmid_io.low, &mmid_io.low_tail);
+        t->queued = false;
+        pthread_mutex_unlock(&mmid_io.mu);
+        mmid_read_group(t->e, t->n, &scratch, &scratch_cap);
+        pthread_mutex_lock(&mmid_io.mu);
+        for (int i = 0; i < t->n; i++) {
+            t->e[i]->task = NULL;
+            atomic_store_explicit(&t->e[i]->state, MMID_READY, memory_order_release);
+        }
+        t->next = mmid_io.free_list; mmid_io.free_list = t;
+        pthread_cond_broadcast(&mmid_io.done);
+    }
+    pthread_mutex_unlock(&mmid_io.mu);
+    free(scratch);
+    return NULL;
+}
+
+// queue one group (the caller set its entries LOADING); without a free task it is read here
+static void mmid_submit(struct mmid_cache_entry * const * es, int n, bool urgent) {
+    pthread_mutex_lock(&mmid_io.mu);
+    struct mmid_task * t = mmid_io.free_list;
+    if (t) {
+        mmid_io.free_list = t->next;
+        for (int i = 0; i < n; i++) { t->e[i] = es[i]; es[i]->task = t; }
+        t->n = n; t->urgent = urgent; t->queued = true;
+        if (urgent) { mmid_append(&mmid_io.high, &mmid_io.high_tail, t); } else { mmid_append(&mmid_io.low, &mmid_io.low_tail, t); }
+        pthread_cond_broadcast(&mmid_io.work);
+    }
+    pthread_mutex_unlock(&mmid_io.mu);
+    if (!t) {
+        mmid_read_group(es, n, NULL, NULL);
+        for (int i = 0; i < n; i++) { atomic_store_explicit(&es[i]->state, MMID_READY, memory_order_release); }
+    }
+}
+
+// an op needs a slice still in the low queue: move it to the urgent queue (early_io::pool::promote)
+static void mmid_promote(struct mmid_cache_entry * e) {
+    pthread_mutex_lock(&mmid_io.mu);
+    struct mmid_task * t = e->task;
+    if (t && t->queued && !t->urgent) {
+        mmid_unlink(&mmid_io.low, &mmid_io.low_tail, t);
+        t->urgent = true;
+        mmid_append(&mmid_io.high, &mmid_io.high_tail, t);
+        pthread_cond_broadcast(&mmid_io.work);
+    }
+    pthread_mutex_unlock(&mmid_io.mu);
+}
+
+static void mmid_wait(struct mmid_cache_entry * e, int ith) {
+    if (atomic_load_explicit(&e->state, memory_order_acquire) != MMID_LOADING) { return; }
+    const int64_t t0 = ith == 0 ? ggml_time_us() : 0;
+    pthread_mutex_lock(&mmid_io.mu);
+    while (atomic_load_explicit(&e->state, memory_order_acquire) == MMID_LOADING) { pthread_cond_wait(&mmid_io.done, &mmid_io.mu); }
+    pthread_mutex_unlock(&mmid_io.mu);
+    if (ith == 0) { mmid_wait_us += ggml_time_us() - t0; }
+}
+
+// split pending slices into groups of file-adjacent ones (COALESCE) and read them: queued (OVERLAP) or now, as the
+// default path does (parallel dispatch over the groups)
+static struct mmid_cache_entry ** mmid_fill_list;
+static int mmid_fill_start[1024 + 1], mmid_fill_groups = 0;
+
+static void mmid_fill_group(void * ctx, size_t g) {
+    (void) ctx;
+    mmid_read_group(mmid_fill_list + mmid_fill_start[g], mmid_fill_start[g + 1] - mmid_fill_start[g], NULL, NULL);
+}
+
+static void mmid_issue(struct mmid_cache_entry ** es, int n, bool urgent) {
+    int groups = 0;
+    for (int i = 0; i < n;) {
+        int j = i + 1;
+        while (mmid_coalesce && j < n && j - i < MMID_GROUP_MAX && es[j]->key == es[j - 1]->key + es[j - 1]->file_size) { j++; }
+        mmid_fill_start[groups++] = i;
+        if (mmid_overlap) { mmid_submit(es + i, j - i, urgent); }
+        i = j;
+    }
+    if (mmid_overlap || groups == 0) { return; }
+    mmid_fill_start[groups] = n;
+    mmid_fill_list = es; mmid_fill_groups = groups;
+    const int64_t t0 = mmid_stats_on ? ggml_time_us() : 0;
+#if defined(__APPLE__)
+    if (groups > 1) {
+        dispatch_apply_f((size_t) groups, dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), NULL, mmid_fill_group);
+    } else
+#endif
+    for (int g = 0; g < groups; g++) { mmid_fill_group(NULL, (size_t) g); }
+    if (mmid_stats_on) { mmid_wait_us += ggml_time_us() - t0; }
+    for (int i = 0; i < n; i++) { atomic_store_explicit(&es[i]->state, MMID_READY, memory_order_relaxed); }
+}
+
+// ---- eviction: O(1) LRU / ClassLRU, adapted from Atomic Engine src/llama-expert-store.cpp
+static struct mmid_cache_entry * mmid_lru_first[MMID_LISTS], * mmid_lru_last[MMID_LISTS];
+static size_t mmid_sizes[MMID_LISTS];
+static int    mmid_n_sizes = 0;
+
+static int mmid_size_class(size_t size) {
+    for (int i = 0; i < mmid_n_sizes; i++) { if (mmid_sizes[i] == size) { return i; } }
+    if (mmid_n_sizes == MMID_LISTS) { return MMID_LISTS - 1; } // more sizes than lists: share the last (buffers then reallocate)
+    mmid_sizes[mmid_n_sizes] = size;
+    return mmid_n_sizes++;
+}
+
+static void mmid_unlink_lru(struct mmid_cache_entry * e) {
+    if (!e->linked) { return; }
+    if (e->older) { e->older->newer = e->newer; } else { mmid_lru_first[e->list] = e->newer; }
+    if (e->newer) { e->newer->older = e->older; } else { mmid_lru_last[e->list] = e->older; }
+    e->older = e->newer = NULL; e->linked = false;
+}
+
+static void mmid_append_lru(struct mmid_cache_entry * e) {
+    e->older = mmid_lru_last[e->list]; e->newer = NULL;
+    if (e->older) { e->older->newer = e; } else { mmid_lru_first[e->list] = e; }
+    mmid_lru_last[e->list] = e; e->linked = true;
+}
+
+// ClassLRU history per (tensor, expert); a tensor's clock counts the tokens of its earlier projections
+static struct { const char * base; uint64_t clock; float * crf; uint64_t * last; int n; } mmid_tensors[MMID_TENSORS];
+static int      mmid_n_tensors = 0, mmid_active_tensor = -1;
+static uint64_t mmid_active_tokens = 0;
+
+static int mmid_tensor_id(const char * base, int n_as) {
+    for (int i = 0; i < mmid_n_tensors; i++) { if (mmid_tensors[i].base == base) { return i; } }
+    if (mmid_n_tensors == MMID_TENSORS) { return -1; }
+    float * crf = calloc((size_t) n_as, sizeof(float)); uint64_t * last = calloc((size_t) n_as, sizeof(uint64_t));
+    if (!crf || !last) { free(crf); free(last); return -1; }
+    mmid_tensors[mmid_n_tensors].base = base; mmid_tensors[mmid_n_tensors].crf = crf;
+    mmid_tensors[mmid_n_tensors].last = last; mmid_tensors[mmid_n_tensors].n = n_as;
+    return mmid_n_tensors++;
+}
+
+// Atomic Engine llama_expert_store::begin_projection: advance the previous projection's clock by its tokens
+static void mmid_begin_projection(int t, uint64_t tokens) {
+    if (t < 0 || t == mmid_active_tensor) { return; } // a down op whose read-ahead already began it
+    if (mmid_active_tensor >= 0) { mmid_tensors[mmid_active_tensor].clock += mmid_active_tokens; }
+    mmid_active_tensor = t; mmid_active_tokens = tokens;
+}
+
+// Atomic Engine impl::touch: eight classes, 128-token half-life, history kept after eviction
+static int mmid_touch(int t, int expert) {
+    if (t < 0) { return 0; }
+    const uint64_t now = mmid_tensors[t].clock;
+    float * crf = &mmid_tensors[t].crf[expert];
+    *crf = *crf * exp2f(-(float) (now - mmid_tensors[t].last[expert]) / 128.0f) + 1.0f;
+    mmid_tensors[t].last[expert] = now;
+    const int cls = (int) log2f(*crf);
+    return cls < 0 ? 0 : (cls > MMID_CLASSES - 1 ? MMID_CLASSES - 1 : cls);
+}
+
+static bool mmid_evictable(const struct mmid_cache_entry * e) {
+    return e->buf && e->pins == 0 && atomic_load_explicit(&e->state, memory_order_acquire) != MMID_LOADING;
+}
+
+static struct mmid_cache_entry * mmid_oldest_unpinned(int list) {
+    struct mmid_cache_entry * c = mmid_lru_first[list];
+    while (c && !mmid_evictable(c)) { c = c->newer; }
+    return c;
+}
+
+static struct mmid_cache_entry * mmid_victim(size_t size) {
+    struct mmid_cache_entry * chosen = NULL;
+    if (mmid_lru == 0) {
+        // the default scan, also skipping pinned and loading slices
+        for (size_t j = 0; j < MMID_CACHE_SLOTS; j++) {
+            const struct mmid_cache_entry * c = &mmid_cache[j];
+            if (c->buf && c->tick + 1024 < mmid_cache_tick && mmid_evictable(c) && (!chosen || c->tick < chosen->tick)) { chosen = &mmid_cache[j]; }
+        }
+        return chosen;
+    }
+    if (mmid_lru == 2) {
+        // take_victim, ClassLRU: the oldest unpinned slice of each class, scored age / 2^class
+        double best = -1;
+        for (int cls = 0; cls < MMID_CLASSES; cls++) {
+            struct mmid_cache_entry * c = mmid_oldest_unpinned(cls);
+            if (!c || c->tensor < 0) { continue; }
+            const double score = ldexp((double) (mmid_tensors[c->tensor].clock - mmid_tensors[c->tensor].last[c->expert]), -cls);
+            if (score > best) { best = score; chosen = c; }
+        }
+        return chosen;
+    }
+    // take_victim with size_lru: the oldest slice of the same size when there is one, else the oldest of any size
+    if (size) {
+        chosen = mmid_oldest_unpinned(mmid_size_class(size));
+        if (chosen) { return chosen; }
+    }
+    for (int l = 0; l < mmid_n_sizes; l++) {
+        struct mmid_cache_entry * c = mmid_oldest_unpinned(l);
+        if (c && (!chosen || c->tick < chosen->tick)) { chosen = c; }
+    }
+    return chosen;
+}
+
+// prefill scratch (COALESCE): [0] the slices of the current op, [1] the read-ahead of its down op; counted in the budget
+static char * mmid_scratch[2];
+static size_t mmid_scratch_cap[2], mmid_scratch_bytes = 0, mmid_scratch_used[2];
+static struct mmid_cache_entry mmid_bp[2][1024]; // scratch-backed slices, by expert
+static bool   mmid_bp1_valid[1024];
+static const char * mmid_bp1_base = NULL;
+
+// evict until size more bytes fit; returns a same-size victim's buffer when there is one
+static char * mmid_make_room(size_t size, bool slice, bool optional, bool * ok) {
+    char * buf = NULL;
+    *ok = true;
+    while (mmid_cache_bytes + mmid_scratch_bytes + size > mmid_cache_budget) {
+        struct mmid_cache_entry * old = mmid_victim(slice ? size : 0);
+        if (!old) { *ok = !optional; break; }
+        mmid_unlink_lru(old);
+        mmid_cache_bytes -= old->size;
+        if (old->size == size && !buf) { buf = old->buf; } else { free(old->buf); }
+        old->buf = NULL;
+    }
+    return buf;
+}
+
+static bool mmid_scratch_reserve(int s, size_t need) {
+    mmid_scratch_used[s] = 0;
+    if (need <= mmid_scratch_cap[s]) { return true; }
+    free(mmid_scratch[s]); mmid_scratch[s] = NULL;
+    mmid_scratch_bytes -= mmid_scratch_cap[s]; mmid_scratch_cap[s] = 0;
+    bool ok;
+    free(mmid_make_room(need, false, false, &ok)); // a prompt workspace reclaims cold slices to fit (Atomic Engine reclaim_to_fit)
+    if (posix_memalign((void **) &mmid_scratch[s], MMID_ALIGN, need) != 0) { mmid_scratch[s] = NULL; return false; }
+    mmid_scratch_cap[s] = need; mmid_scratch_bytes += need;
+    return true;
+}
+
+static struct mmid_cache_entry * mmid_bp_entry(int s, int cur_a, const char * key, size_t file_size, size_t size,
+                                               enum ggml_type type, int64_t ne0, int64_t ne1, bool repacked) {
+    struct mmid_cache_entry * e = &mmid_bp[s][cur_a];
+    if (mmid_scratch_used[s] + size > mmid_scratch_cap[s]) { return NULL; }
+    e->key = key; e->size = size; e->buf = mmid_scratch[s] + mmid_scratch_used[s];
+    e->file_size = file_size; e->ne0 = ne0; e->ne1 = ne1; e->src_type = type; e->repacked = repacked;
+    mmid_scratch_used[s] += GGML_PAD(size, 64);
+    atomic_store_explicit(&e->state, MMID_LOADING, memory_order_relaxed);
+    mmid_bypass_reads++;
+    return e;
+}
+
+// wait for scratch-1 read-ahead that no op consumed before its scratch is reused or freed
+static void mmid_drain_bp1(void) {
+    for (int i = 0; i < 1024; i++) {
+        if (mmid_bp1_valid[i]) { mmid_pf_wasted++; mmid_bp1_valid[i] = false; }
+        if (mmid_bp[1][i].key) { mmid_promote(&mmid_bp[1][i]); mmid_wait(&mmid_bp[1][i], 1); mmid_bp[1][i].key = NULL; }
+    }
+    mmid_bp1_base = NULL;
+}
+
+// ---- cache table
+static struct mmid_cache_entry * mmid_slot(const char * key) {
+    size_t i = ((uintptr_t) key >> 6) % MMID_CACHE_SLOTS;
+    while (mmid_cache[i].key && mmid_cache[i].key != key) { i = (i + 1) % MMID_CACHE_SLOTS; }
+    return &mmid_cache[i];
+}
+
+static void mmid_touch_entry(struct mmid_cache_entry * e) {
+    e->tick = ++mmid_cache_tick;
+    if (!mmid_lru) { return; }
+    mmid_unlink_lru(e);
+    e->list = mmid_lru == 2 ? mmid_touch(e->tensor, e->expert) : e->sz;
+    mmid_append_lru(e);
+}
+
+// a new LOADING slice in the cache, or NULL (optional and no unpinned victim, or no memory)
+static struct mmid_cache_entry * mmid_new_entry(const char * key, size_t file_size, size_t size,
+                                                enum ggml_type type, int64_t ne0, int64_t ne1, bool repacked,
+                                                int t, int expert, bool optional) {
+    bool ok;
+    char * buf = mmid_make_room(size, true, optional, &ok);
+    if (!ok) { free(buf); return NULL; }
+    if (!buf && posix_memalign((void **) &buf, MMID_ALIGN, size) != 0) { return NULL; }
+    struct mmid_cache_entry * e = mmid_slot(key);
+    e->key = key; e->buf = buf; e->size = size;
+    e->file_size = file_size; e->ne0 = ne0; e->ne1 = ne1; e->src_type = type; e->repacked = repacked;
+    e->sz = mmid_size_class(size); e->tensor = t; e->expert = expert;
+    atomic_store_explicit(&e->state, MMID_LOADING, memory_order_relaxed);
+    mmid_cache_bytes += size;
+    mmid_cache_misses++; mmid_cache_miss_bytes += file_size;
+    mmid_touch_entry(e);
+    return e;
+}
+
+// per op: the pins to drop at the next op, the read-ahead entries, the compute order and the slices to wait for
+static struct mmid_cache_entry * mmid_pinned[2048], * mmid_pf[1024], * mmid_wait_e[1024], * mmid_pend[1024];
+static int mmid_n_pinned = 0, mmid_n_pf = 0, mmid_order[1024], mmid_n_order = 0;
+
+static void mmid_pin(struct mmid_cache_entry * e) { e->pins++; mmid_pinned[mmid_n_pinned++] = e; }
+
+// read-ahead that no down op consumed: wasted (the slice stays cached, unpinned)
+static void mmid_retire_prefetch(void) {
+    for (int i = 0; i < mmid_n_pf; i++) {
+        struct mmid_cache_entry * e = mmid_pf[i];
+        if (!e->prefetched) { continue; }
+        e->prefetched = false; e->pins--;
+        if (e->pf_issued) { e->pf_issued = false; mmid_pf_wasted++; }
+    }
+    mmid_n_pf = 0;
+}
+
+// known-route overlap: the down op of this layer uses the same experts; read its missing slices on the low queue
+static void mmid_prefetch_down(const char * down, size_t nb2, enum ggml_type down_type, int64_t down_ne0, int64_t down_ne1,
+                               int n_as, const int64_t * counts, const bool * bypass_a, uint64_t tokens) {
+    const int t = mmid_lru == 2 ? mmid_tensor_id(down, n_as) : -1;
+    mmid_begin_projection(t, tokens);
+    mmid_drain_bp1();
+    const size_t rep_sz = mmid_repack_mode ? ggml_mmid_repack_info(down_type, down_ne0, down_ne1, mmid_repack_mode, NULL) : 0;
+    const bool do_repack = rep_sz > 0;
+    const size_t entry_sz = do_repack ? rep_sz : nb2;
+    size_t need = 0;
+    for (int a = 0; a < n_as; a++) {
+        if (counts[a] > 0 && bypass_a[a] && !mmid_slot(down + a * nb2)->buf) { need += GGML_PAD(entry_sz, 64); }
+    }
+    const bool scratch_ok = need == 0 || mmid_scratch_reserve(1, need);
+    mmid_bp1_base = down;
+    int n = 0;
+    // resident down slices first, so the read-ahead below cannot evict them
+    for (int a = 0; a < n_as; a++) {
+        if (counts[a] == 0) { continue; }
+        struct mmid_cache_entry * e = mmid_slot(down + a * nb2);
+        if (e->buf && !e->prefetched) { e->prefetched = true; e->pins++; mmid_pf[mmid_n_pf++] = e; }
+    }
+    for (int a = 0; a < n_as; a++) {
+        if (counts[a] == 0) { continue; }
+        const char * key = down + a * nb2;
+        if (mmid_slot(key)->buf) { continue; }
+        struct mmid_cache_entry * e;
+        if (bypass_a[a]) {
+            if (!scratch_ok || !(e = mmid_bp_entry(1, a, key, nb2, entry_sz, down_type, down_ne0, down_ne1, do_repack))) { continue; }
+            mmid_bp1_valid[a] = true;
+        } else {
+            e = mmid_new_entry(key, nb2, entry_sz, down_type, down_ne0, down_ne1, do_repack, t, a, true);
+            if (!e) { break; } // no unpinned victim: skip the rest of the read-ahead
+            e->prefetched = true; e->pf_issued = true; e->pins++; mmid_pf[mmid_n_pf++] = e;
+        }
+        mmid_pf_issued++;
+        mmid_pend[n++] = e;
+    }
+    mmid_issue(mmid_pend, n, false);
+}
+
+static void mmid_port_prologue(const char * base, size_t nb02, enum ggml_type type, int64_t ne0, int64_t ne1,
+                               int n_as, const int64_t * counts, const struct ggml_tensor * ids) {
+    const uint64_t tokens = (uint64_t) ids->ne[1];
+    const bool prefill = tokens > 1;
+    // the previous op is done on every thread (node barrier)
+    for (int i = 0; i < mmid_n_pinned; i++) { mmid_pinned[i]->pins--; }
+    mmid_n_pinned = 0;
+    if (!prefill && mmid_scratch_bytes) {
+        // first decode op: return the prompt scratch to the cache budget
+        mmid_drain_bp1();
+        for (int s = 0; s < 2; s++) { free(mmid_scratch[s]); mmid_scratch[s] = NULL; mmid_scratch_cap[s] = 0; }
+        mmid_scratch_bytes = 0;
+    }
+    const char * down = NULL; size_t down_nb2 = 0;
+    enum ggml_type down_type = GGML_TYPE_F32; int64_t down_ne0 = 0, down_ne1 = 0;
+    const bool pair = mmid_overlap && ggml_mmid_get_pair_meta(base, &down, &down_nb2, &down_type, &down_ne0, &down_ne1);
+    if (pair) { mmid_retire_prefetch(); }
+    const int t = mmid_lru == 2 ? mmid_tensor_id(base, n_as) : -1;
+    mmid_begin_projection(t, tokens);
+
+    // prefill non-tail bypass: only the experts of the last prompt row go to the cache. Atomic Engine marks the prompt
+    // tail only for ubatches of >= 512 tokens (src/llama-context.cpp, mark_inkling_prompt_tail); shorter prompts are cached
+    const bool bypass = mmid_coalesce && tokens >= MMID_BYPASS_MIN_TOKENS;
+    static bool bypass_a[1024];
+    for (int a = 0; a < n_as; a++) { bypass_a[a] = bypass && counts[a] > 0; }
+    if (bypass) {
+        for (int id = 0; id < ids->ne[0]; id++) {
+            const int32_t a = *(const int32_t *) ((const char *) ids->data + (tokens - 1)*ids->nb[1] + id*ids->nb[0]);
+            if (a >= 0 && a < n_as) { bypass_a[a] = false; }
+        }
+    }
+
+    const size_t rep_sz = mmid_repack_mode ? ggml_mmid_repack_info(type, ne0, ne1, mmid_repack_mode, NULL) : 0;
+    const bool do_repack = rep_sz > 0;
+    const size_t entry_sz = do_repack ? rep_sz : nb02;
+
+    int n_ready = 0, n_wait = 0, n_pend = 0;
+    static int wait_a[1024], miss_a[1024];
+    int n_miss = 0;
+    const bool bp1 = mmid_bp1_base == base;
+    for (int a = 0; a < n_as; a++) {
+        mmid_wait_e[a] = NULL;
+        mmid_cache_repacked[a] = false;
+        if (counts[a] == 0) { continue; }
+        const char * key = base + a * nb02;
+        struct mmid_cache_entry * e = mmid_slot(key);
+        if (e->buf) {
+            if (e->prefetched) {
+                mmid_pin(e); e->prefetched = false; e->pins--; // the read-ahead pin becomes this op's pin
+                if (e->pf_issued) { e->pf_issued = false; mmid_pf_used++; }
+                e->tick = ++mmid_cache_tick;
+            } else {
+                mmid_touch_entry(e); mmid_pin(e);
+            }
+            mmid_cache_hits++;
+        } else if (bp1 && mmid_bp1_valid[a] && mmid_bp[1][a].key == key) {
+            e = &mmid_bp[1][a]; mmid_bp1_valid[a] = false; mmid_pf_used++;
+        } else {
+            miss_a[n_miss++] = a;
+            continue;
+        }
+        mmid_cache_ptr[a] = e->buf;
+        mmid_cache_repacked[a] = e->repacked;
+        if (atomic_load_explicit(&e->state, memory_order_acquire) == MMID_LOADING) {
+            mmid_promote(e); mmid_wait_e[a] = e; wait_a[n_wait++] = a;
+        } else {
+            mmid_order[n_ready++] = a;
+        }
+    }
+
+    size_t need = 0;
+    for (int i = 0; i < n_miss; i++) { if (bypass_a[miss_a[i]]) { need += GGML_PAD(entry_sz, 64); } }
+    const bool scratch_ok = need == 0 || mmid_scratch_reserve(0, need);
+    for (int i = 0; i < n_miss; i++) {
+        const int a = miss_a[i];
+        const char * key = base + a * nb02;
+        struct mmid_cache_entry * e = NULL;
+        if (bypass_a[a] && scratch_ok) {
+            e = mmid_bp_entry(0, a, key, nb02, entry_sz, type, ne0, ne1, do_repack);
+            if (e) { mmid_cache_misses++; mmid_cache_miss_bytes += nb02; }
+        }
+        if (!e) { e = mmid_new_entry(key, nb02, entry_sz, type, ne0, ne1, do_repack, t, a, false); if (e) { mmid_pin(e); } }
+        if (!e) { mmid_cache_ptr[a] = key; mmid_cache_repacked[a] = false; mmid_order[n_ready++] = a; continue; } // no memory: read the mapping
+        mmid_cache_ptr[a] = e->buf;
+        mmid_cache_repacked[a] = e->repacked;
+        mmid_wait_e[a] = e; wait_a[n_wait++] = a;
+        mmid_pend[n_pend++] = e;
+    }
+    mmid_issue(mmid_pend, n_pend, true);
+    if (pair) { mmid_prefetch_down(down, down_nb2, down_type, down_ne0, down_ne1, n_as, counts, bypass_a, tokens); }
+
+    // resident experts first, then the ones still loading
+    for (int i = 0; i < n_wait; i++) { mmid_order[n_ready + i] = wait_a[i]; }
+    mmid_n_order = n_ready + n_wait;
+}
+
+static int mmid_env(const char * name) { const char * v = getenv(name); return v ? atoi(v) : 0; }
