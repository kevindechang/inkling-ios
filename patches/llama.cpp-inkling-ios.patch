+void ggml_arm_repack_iq2_xxs_4x4(void * GGML_RESTRICT dst_v, const void * GGML_RESTRICT src_v, int64_t ne0, int64_t ne1) {
+    init_mmid_repack_luts();
+    const int64_t nb = ne0 / QK_K;
+    const block_iq2_xxs * src = (const block_iq2_xxs *) src_v;
+    block_iq2_4x4 * dst = (block_iq2_4x4 *) dst_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            block_iq2_4x4 out;
+            for (int i = 0; i < 4; ++i) {
+                const block_iq2_xxs & in = src[(r + i) * nb + b];
+                out.d[i] = in.d;
+                for (int ib32 = 0; ib32 < 8; ++ib32) {
+                    uint32_t aux32[2];
+                    memcpy(aux32, in.qs + ib32 * 4, 2 * sizeof(uint32_t));
+                    const uint8_t * aux8 = (const uint8_t *) aux32;
+                    const uint8_t sc = (uint8_t) (aux32[1] >> 28);
+                    out.scales[ib32 * 4 + i] = (uint8_t) (sc | (sc << 4));
+                    for (int h = 0; h < 2; ++h) {
+                        const int sb = ib32 * 2 + h;
+                        const pair_u32 p0 = g_iq2xxs_lut[aux8[h * 2 + 0]];
+                        const pair_u32 s0 = g_keven_sgn_lut[(aux32[1] >> (7 * (h * 2 + 0))) & 127];
+                        const pair_u32 p1 = g_iq2xxs_lut[aux8[h * 2 + 1]];
+                        const pair_u32 s1 = g_keven_sgn_lut[(aux32[1] >> (7 * (h * 2 + 1))) & 127];
+                        uint32_t w0 = (p0.lo4 | s0.lo4) | ((p1.lo4 | s1.lo4) << 4);
+                        uint32_t w1 = (p0.hi4 | s0.hi4) | ((p1.hi4 | s1.hi4) << 4);
+                        memcpy(out.qs + sb * 32 + 0  + i * 4, &w0, 4);
+                        memcpy(out.qs + sb * 32 + 16 + i * 4, &w1, 4);
+                    }
+                }
+            }
+            *dst++ = out;
+        }
+    }
+}
