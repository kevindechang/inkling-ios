+static uint32_t mmid_q2_0_unpack4(uint32_t v, uint8_t * s) {
+    for (int t = 0; t < 4; ++t) {
+        uint8_t b = 0;
+        for (int m = 0; m < 4; ++m) {
+            const uint8_t lane = (uint8_t) ((v >> (8 * m)) & 0xff);
+            const uint8_t q = (uint8_t) ((lane >> (2 * t)) & 3);
+            b = (uint8_t) (b | (q << (2 * m)));
+        }
+        s[t] = b;
+    }
+    return v;
+}
+
+static void mmid_unrepack_q2_0_4x4(void * dst_v, const void * src_v, int64_t ne0, int64_t ne1) {
+    const int64_t nb = ne0 / QK2_0;
+    block_q2_0 * dst = (block_q2_0 *) dst_v;
+    const block_q2_0x4 * src = (const block_q2_0x4 *) src_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            const block_q2_0x4 & in = *src++;
+            for (int i = 0; i < 4; ++i) {
+                block_q2_0 & out = dst[(r + i) * nb + b];
+                out.d = in.d[i];
+                for (int k = 0; k < 2; ++k) {
+                    uint32_t v0, v1;
+                    memcpy(&v0, in.qs + k * 32 + i * 4, 4);
+                    memcpy(&v1, in.qs + k * 32 + 16 + i * 4, 4);
+                    mmid_q2_0_unpack4(v0, out.qs + k * 8);
+                    mmid_q2_0_unpack4(v1, out.qs + k * 8 + 4);
+                }
+            }
+        }
+    }
+}
+
+static void mmid_unrepack_q2_K_4x4(void * dst_v, const void * src_v, int64_t ne0, int64_t ne1) {
+    const int64_t nb = ne0 / QK_K;
+    block_q2_K * dst = (block_q2_K *) dst_v;
+    const block_q2_Kx4 * src = (const block_q2_Kx4 *) src_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            const block_q2_Kx4 & in = *src++;
+            block_q2_K * row[4] = {
+                &dst[(r + 0) * nb + b],
+                &dst[(r + 1) * nb + b],
+                &dst[(r + 2) * nb + b],
+                &dst[(r + 3) * nb + b],
+            };
+            for (int j = 0; j < 4; ++j) {
+                row[j]->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d    = in.d[j];
+                row[j]->GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin = in.dmin[j];
+            }
+            // inverse of vst4q_u8 on the 16-byte scale vectors
+            for (int i = 0; i < 16; ++i) {
+                for (int j = 0; j < 4; ++j) {
+                    row[j]->scales[i] = in.scales[i * 4 + j];
+                }
+            }
+            // inverse of vst4q_u32 on each 16-byte qs chunk
+            for (int c = 0; c < 4; ++c) {
+                const uint32_t * p = (const uint32_t *) (in.qs + c * 64);
+                for (int i = 0; i < 4; ++i) {
+                    for (int j = 0; j < 4; ++j) {
+                        memcpy(row[j]->qs + c * 16 + i * 4, &p[i * 4 + j], 4);
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void mmid_unrepack_grouped(enum ggml_type type, int64_t ne0, int64_t ne1, void * dst_v, const void * src_v, int inter, int nrows) {
+    const int nblocks = (int) (type == GGML_TYPE_Q4_K ? ne0 / QK_K : type == GGML_TYPE_IQ4_NL ? ne0 / QK4_NL : ne0 / QK4_0);
+    const uint8_t * src = (const uint8_t *) src_v;
+    uint8_t * dst = (uint8_t *) dst_v;
+    const size_t row_blocks_off = (size_t) nblocks;
+    for (int64_t r = 0; r < ne1; r += nrows) {
+        for (int x = 0; x < nblocks; ++x) {
+            if (type == GGML_TYPE_Q4_0) {
+                block_q4_0 tmp[4];
+                mmid_unmake_q4_0x4(tmp, (const block_q4_0x4 *) src, inter);
+                src += sizeof(block_q4_0x4);
+                for (int i = 0; i < 4; ++i) {
+                    memcpy(dst + ((size_t) (r + i) * row_blocks_off + (size_t) x) * sizeof(block_q4_0), &tmp[i], sizeof(block_q4_0));
+                }
+            } else if (type == GGML_TYPE_Q4_K) {
+                block_q4_K tmp[8];
+                mmid_unmake_q4_Kx8(tmp, (const block_q4_Kx8 *) src, inter);
+                src += sizeof(block_q4_Kx8);
+                for (int i = 0; i < 8; ++i) {
+                    memcpy(dst + ((size_t) (r + i) * row_blocks_off + (size_t) x) * sizeof(block_q4_K), &tmp[i], sizeof(block_q4_K));
+                }
+            } else {
+                block_iq4_nl tmp[4];
+                mmid_unmake_iq4_nlx4(tmp, (const block_iq4_nlx4 *) src);
+                src += sizeof(block_iq4_nlx4);
+                for (int i = 0; i < 4; ++i) {
+                    memcpy(dst + ((size_t) (r + i) * row_blocks_off + (size_t) x) * sizeof(block_iq4_nl), &tmp[i], sizeof(block_iq4_nl));
+                }
+            }
+        }
+    }
+}
+
+GGML_BACKEND_API void ggml_mmid_unrepack_slice(enum ggml_type type, int64_t ne0, int64_t ne1, void * dst, const void * src, size_t src_size) {
+    const size_t expect = ggml_row_size(type, ne0) * (size_t) ne1;
+    GGML_ASSERT(src_size == expect);
+    const int inter = ggml_cpu_has_matmul_int8() ? 8 : 4;
+    switch (type) {
+        case GGML_TYPE_Q2_0:   mmid_unrepack_q2_0_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_Q2_K:   mmid_unrepack_q2_K_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_Q4_0:   mmid_unrepack_grouped(type, ne0, ne1, dst, src, inter, 4); break;
+        case GGML_TYPE_Q4_K:   mmid_unrepack_grouped(type, ne0, ne1, dst, src, inter, 8); break;
+        case GGML_TYPE_IQ4_NL: mmid_unrepack_grouped(type, ne0, ne1, dst, src, 4, 4); break;
+        default: GGML_ABORT("unsupported ggml_mmid_unrepack_slice type %d", (int) type);
+    }
+}
+
+void ggml_mmid_repack_gemv(enum ggml_type type, int64_t ne0, int64_t ne1,
+                           const void * repacked_slice, int64_t ir0_start, int64_t ir0_end,
+                           const void * src1_col, float * dst_col) {
+    const int nc = (int) (ir0_end - ir0_start);
+    const bool i8mm = ggml_cpu_has_matmul_int8();
+    const char * base = (const char *) repacked_slice;
+    const size_t row_sz = ggml_row_size(type, ne0);
+    switch (type) {
+        case GGML_TYPE_MXFP4:
+            if (ggml_arm_mmid_has_custom_kernels()) {
+                ggml_arm_gemv_mxfp4_4x4_q8_0_exact((int) ne0, dst_col, base + (size_t) ir0_start * row_sz, src1_col, nc);
+            } else {
+                ggml_gemv_mxfp4_4x4_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc);
+            }
+            break;
+        case GGML_TYPE_Q4_0:
+            if (i8mm) { ggml_gemv_q4_0_4x8_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            else      { ggml_gemv_q4_0_4x4_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            break;
+        case GGML_TYPE_IQ4_NL:
+            ggml_gemv_iq4_nl_4x4_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc);
+            break;
+        case GGML_TYPE_Q8_0:
+            if (i8mm) { ggml_gemv_q8_0_4x8_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            else      { ggml_gemv_q8_0_4x4_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            break;
+        case GGML_TYPE_Q1_0:
+            if (i8mm) { ggml_gemv_q1_0_4x8_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            else      { ggml_gemv_q1_0_4x4_q8_0((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            break;
+        case GGML_TYPE_Q4_K:
+            if (i8mm) { ggml_gemv_q4_K_8x8_q8_K((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            else      { ggml_gemv_q4_K_8x4_q8_K((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            break;
+        case GGML_TYPE_Q5_K:
+            if (i8mm) { ggml_gemv_q5_K_8x8_q8_K((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            else      { ggml_gemv_q5_K_8x4_q8_K((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            break;
+        case GGML_TYPE_Q6_K:
+            if (i8mm) { ggml_gemv_q6_K_8x8_q8_K((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            else      { ggml_gemv_q6_K_8x4_q8_K((int) ne0, dst_col, (size_t) ne1, base + (size_t) ir0_start * row_sz, src1_col, 1, nc); }
+            break;
+        case GGML_TYPE_Q2_0:
+            ggml_arm_gemv_q2_0_4x4_q8_0((int) ne0, dst_col, base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK2_0) * sizeof(block_q2_0x4), src1_col, nc);
+            break;
+        case GGML_TYPE_NVFP4:
+            ggml_arm_gemv_nvfp4_4x4_q8_0((int) ne0, dst_col, base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK_NVFP4) * sizeof(block_nvfp4x4), src1_col, nc);
+            break;
+        case GGML_TYPE_Q2_K:
+            ggml_arm_gemv_q2_K_4x4_q8_K((int) ne0, dst_col, base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK_K) * sizeof(block_q2_Kx4), src1_col, nc);
+            break;
+        case GGML_TYPE_IQ1_S:
+            ggml_arm_gemv_iq1_s_4x4_q8_K((int) ne0, dst_col, base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK_K) * sizeof(block_iq1_sx4), src1_col, nc);
+            break;
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ2_XXS:
+            ggml_arm_gemv_iq2_4x4_q8_K((int) ne0, dst_col, base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK_K) * sizeof(block_iq2_4x4), src1_col, nc);
+            break;
+        default:
+            GGML_ABORT("unsupported ggml_mmid_repack_gemv type %d", (int) type);
+    }
+}
+
+static inline void pack_q8_0_rows_to_4x(const void * const * src1_cols, int nr, int nb, int inter, block_q8_0x4 * dst) {
+    const int n_chunks = QK8_0 / inter;
+    for (int b = 0; b < nb; ++b) {
+        block_q8_0x4 & out = dst[b];
+        memset(&out, 0, sizeof(out));
+        for (int m = 0; m < nr; ++m) {
+            const block_q8_0 & in = ((const block_q8_0 *) src1_cols[m])[b];
+            out.d[m] = in.d;
+            for (int k = 0; k < n_chunks; ++k) {
+                memcpy(out.qs + (k * 4 + m) * inter, in.qs + k * inter, (size_t) inter);
+            }
+        }
+    }
+}
+
+static inline void pack_q8_K_rows_to_4x(const void * const * src1_cols, int nr, int nb, int inter, block_q8_Kx4 * dst) {
+    const int n_chunks = QK_K / inter;
+    for (int b = 0; b < nb; ++b) {
+        block_q8_Kx4 & out = dst[b];
+        memset(&out, 0, sizeof(out));
+        for (int m = 0; m < nr; ++m) {
+            const block_q8_K & in = ((const block_q8_K *) src1_cols[m])[b];
+            out.d[m] = in.d;
+            for (int k = 0; k < n_chunks; ++k) {
+                memcpy(out.qs + (k * 4 + m) * inter, in.qs + k * inter, (size_t) inter);
+            }
+            for (int sb = 0; sb < 16; ++sb) {
+                out.bsums[(sb >> 2) * 16 + m * 4 + (sb & 3)] = in.bsums[sb];
+            }
+        }
+    }
+}
+
+void ggml_mmid_repack_gemm(enum ggml_type type, int64_t ne0, int64_t ne1,
+                           const void * repacked_slice, int64_t ir0_start, int64_t ir0_end,
+                           const void * const * src1_cols, float * const * dst_cols, int nr) {
+    if (nr <= 1) {
+        if (nr == 1) {
+            ggml_mmid_repack_gemv(type, ne0, ne1, repacked_slice, ir0_start, ir0_end, src1_cols[0], dst_cols[0]);
+        }
+        return;
+    }
+    const int nc = (int) (ir0_end - ir0_start);
+    const char * base = (const char *) repacked_slice;
+    const bool i8mm = ggml_cpu_has_matmul_int8();
+
+    if (type == GGML_TYPE_Q2_K && nr <= 4) {
+        ggml_arm_gemm_q2_K_4x4_q8_K((int) ne0, dst_cols,
+                base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK_K) * sizeof(block_q2_Kx4),
+                src1_cols, nr, nc);
+        return;
+    }
+    if (type == GGML_TYPE_Q2_0 && nr <= 4) {
+        ggml_arm_gemm_q2_0_4x4_q8_0((int) ne0, dst_cols,
+                base + (size_t) (ir0_start / 4) * (size_t) (ne0 / QK2_0) * sizeof(block_q2_0x4),
+                src1_cols, nr, nc);
+        return;
+    }
+    if (type == GGML_TYPE_Q4_0 && nr == 4 && ne0 <= 4096 && nc <= 512) {
+        const int nb = (int) (ne0 / QK8_0);
+        const int inter = i8mm ? 8 : 4;
+        block_q8_0x4 a_pack[128];
+        float c_tmp[4 * 512];
+        pack_q8_0_rows_to_4x(src1_cols, nr, nb, inter, a_pack);
+        const size_t row_sz = ggml_row_size(type, ne0);
+        const void * vx = base + (size_t) ir0_start * row_sz;
+        if (i8mm) { ggml_gemm_q4_0_4x8_q8_0((int) ne0, c_tmp, (size_t) nc, vx, a_pack, 4, nc); }
+        else      { ggml_gemm_q4_0_4x4_q8_0((int) ne0, c_tmp, (size_t) nc, vx, a_pack, 4, nc); }
+        for (int m = 0; m < nr; ++m) {
+            memcpy(dst_cols[m], c_tmp + (size_t) m * (size_t) nc, (size_t) nc * sizeof(float));
+        }
+        return;
+    }
+    if (type == GGML_TYPE_Q4_K && nr >= 3 && nr <= 4 && ne0 <= 4096 && nc <= 512) {
+        const int nb = (int) (ne0 / QK_K);
+        const int inter = i8mm ? 8 : 4;
+        block_q8_Kx4 a_pack[16];
+        float c_tmp[4 * 512];
+        pack_q8_K_rows_to_4x(src1_cols, nr, nb, inter, a_pack);
+        const size_t row_sz = ggml_row_size(type, ne0);
+        const void * vx = base + (size_t) ir0_start * row_sz;
+        if (i8mm) { ggml_gemm_q4_K_8x8_q8_K((int) ne0, c_tmp, (size_t) nc, vx, a_pack, 4, nc); }
+        else      { ggml_gemm_q4_K_8x4_q8_K((int) ne0, c_tmp, (size_t) nc, vx, a_pack, 4, nc); }
+        for (int m = 0; m < nr; ++m) {
+            memcpy(dst_cols[m], c_tmp + (size_t) m * (size_t) nc, (size_t) nc * sizeof(float));
+        }
+        return;
+    }
+    for (int m = 0; m < nr; ++m) {
+        ggml_mmid_repack_gemv(type, ne0, ne1, repacked_slice, ir0_start, ir0_end, src1_cols[m], dst_cols[m]);
+    }
+}
+
+static int ggml_lm_head_q4_k_interleave(void) {
+    if (ggml_cpu_has_avx2()) {
+        return 8;
+    }
+    if (ggml_cpu_has_neon() && ggml_cpu_has_matmul_int8()) {
+        return 8;
+    }
+    if (ggml_cpu_has_neon() && ggml_cpu_has_dotprod()) {
+        return 4;
+    }
+    return 0;
+}
+
+static bool ggml_lm_head_q4_k_supported(const struct ggml_tensor * w) {
+    if (!w || w->type != GGML_TYPE_Q4_K || !w->buffer) {
+        return false;
+    }
+    if (w->buffer->buft != ggml_backend_cpu_repack_buffer_type()) {
+        return false;
+    }
+    if (w->ne[0] % QK_K != 0 || w->ne[1] % 8 != 0) {
+        return false;
+    }
+    return ggml_lm_head_q4_k_interleave() != 0;
+}
+
+static void ggml_lm_head_q4_k_unrepack_row(const struct ggml_tensor * w, int64_t row, void * dst_q4_k) {
+    const int bl = ggml_lm_head_q4_k_interleave();
+    GGML_ASSERT(bl == 4 || bl == 8);
+    const int64_t nblocks = w->ne[0] / QK_K;
+    const int64_t grp = row / 8;
+    const int lane = (int) (row % 8);
+    const block_q4_Kx8 * src = (const block_q4_Kx8 *) w->data + grp * nblocks;
+    block_q4_K * out = (block_q4_K *) dst_q4_k;
+    const int chunks = (QK_K / 2) / bl;
+
+    for (int64_t x = 0; x < nblocks; ++x) {
+        out[x].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d    = src[x].d[lane];
+        out[x].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin = src[x].dmin[lane];
+        for (int c = 0; c < chunks; ++c) {
+            memcpy(&out[x].qs[c * bl], &src[x].qs[(c * 8 + lane) * bl], (size_t) bl);
+        }
+        for (int i = 0; i < 4; ++i) {
+            uint8_t s_lo, m_lo, s_hi, m_hi;
+            const uint8_t * sc0 = &src[x].scales[i * 12];
+            const uint8_t * sc1 = &src[x].scales[48 + i * 12];
+            if (lane < 4) {
+                s_lo = sc0[lane] & 63;
+                m_lo = sc0[4 + lane] & 63;
+                s_hi = sc1[lane] & 63;
+                m_hi = sc1[4 + lane] & 63;
+            } else {
+                const int l = lane - 4;
+                s_lo = ((sc0[l] & 192) >> 2) | (sc0[8 + l] & 15);
+                m_lo = ((sc0[4 + l] & 192) >> 2) | ((sc0[8 + l] & 240) >> 4);
+                s_hi = ((sc1[l] & 192) >> 2) | (sc1[8 + l] & 15);
+                m_hi = ((sc1[4 + l] & 192) >> 2) | ((sc1[8 + l] & 240) >> 4);
+            }
+            out[x].scales[i]     = (s_lo & 63) | ((s_hi & 48) << 2);
+            out[x].scales[i + 4] = (m_lo & 63) | ((m_hi & 48) << 2);
+            out[x].scales[i + 8] = (s_hi & 15) | ((m_hi & 15) << 4);
+        }
+    }
+}
+
+static void ggml_lm_head_q4_k_repack_rows(int64_t ne0, int64_t n_rows, const void * src_q4_k, void * dst_repacked) {
+    const int bl = ggml_lm_head_q4_k_interleave();
+    GGML_ASSERT((bl == 4 || bl == 8) && (n_rows % 8 == 0));
+    struct ggml_tensor t;
+    memset(&t, 0, sizeof(t));
+    t.type  = GGML_TYPE_Q4_K;
+    t.ne[0] = ne0;
+    t.ne[1] = n_rows;
+    t.ne[2] = 1;
+    t.ne[3] = 1;
+    t.data  = dst_repacked;
+    const size_t data_size = (size_t) n_rows * ggml_row_size(GGML_TYPE_Q4_K, ne0);
+    const int rc = repack_q4_K_to_q4_K_8_bl(&t, bl, src_q4_k, data_size);
+    GGML_ASSERT(rc == 0);
+}
+
+static void ggml_lm_head_q4_k_quantize_h(int64_t ne0, const float * h_f32, void * dst_q8_k) {
+    ggml_get_type_traits_cpu(GGML_TYPE_Q8_K)->from_float(h_f32, dst_q8_k, ne0);
+}
+
+static void ggml_lm_head_q8_k_dequant(int64_t ne0, const void * src_q8_k, float * dst_f32) {
+    const int64_t nb = ne0 / QK_K;
+    const block_q8_K * b = (const block_q8_K *) src_q8_k;
+    for (int64_t i = 0; i < nb; ++i) {
+        const float d = b[i].d;
+        for (int j = 0; j < QK_K; ++j) {
+            dst_f32[i * QK_K + j] = d * (float) b[i].qs[j];
+        }
+    }
+}
+
+static void ggml_lm_head_q4_k_gemv_rows(int64_t ne0, int64_t total_rows, const void * repacked_w,
+                                        int64_t row_start, int64_t n_rows, const void * src_q8_k, float * dst) {
+    GGML_ASSERT((row_start % 8 == 0) && (n_rows % 8 == 0));
+    const int bl = ggml_lm_head_q4_k_interleave();
+    const size_t row_sz = ggml_row_size(GGML_TYPE_Q4_K, ne0);
+    const char * base = (const char *) repacked_w + (size_t) row_start * row_sz;
+    if (bl == 8) {
+        ggml_gemv_q4_K_8x8_q8_K((int) ne0, dst, (size_t) total_rows, base, src_q8_k, 1, (int) n_rows);
+    } else {
+        ggml_gemv_q4_K_8x4_q8_K((int) ne0, dst, (size_t) total_rows, base, src_q8_k, 1, (int) n_rows);
+    }
+}
+
+const struct ggml_cpu_lm_head_ops * ggml_cpu_lm_head_get_ops(void) {
+    static const struct ggml_cpu_lm_head_ops ops = {
+        /* .q4_k_repack_supported = */ ggml_lm_head_q4_k_supported,
+        /* .q4_k_unrepack_row     = */ ggml_lm_head_q4_k_unrepack_row,
+        /* .q4_k_repack_rows      = */ ggml_lm_head_q4_k_repack_rows,
+        /* .q4_k_quantize_h       = */ ggml_lm_head_q4_k_quantize_h,
+        /* .q8_k_dequant          = */ ggml_lm_head_q8_k_dequant,
+        /* .q4_k_gemv_rows        = */ ggml_lm_head_q4_k_gemv_rows,
+    };
+    return &ops;
+}
+
+} // extern "C"
