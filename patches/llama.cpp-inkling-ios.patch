diff --git a/ggml/src/ggml-cpu/row-bcast-neon.h b/ggml/src/ggml-cpu/row-bcast-neon.h
new file mode 100644
index 0000000..9fc287a
--- /dev/null
+++ b/ggml/src/ggml-cpu/row-bcast-neon.h
@@ -0,0 +1,80 @@
+#pragma once
+
+// Row-broadcast f32 binary op: dst[i] = src0[i] <op> scalar.
+// NEON vaddq/vsubq/vmulq/vdivq are IEEE-754 operations, so this matches the scalar op
+// bit for bit (vdivq_f32 is a real division, not a reciprocal estimate).
+
+#include <cstdint>
+
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+#include <arm_neon.h>
+#define ROW_BCAST_HAS_NEON 1
+#endif
+
+enum {
+    ROW_BCAST_ADD = 1,
+    ROW_BCAST_SUB = 2,
+    ROW_BCAST_MUL = 3,
+    ROW_BCAST_DIV = 4,
+};
+
+inline void row_bcast_f32(int op, float * d, const float * x, float s, int64_t n) {
+    int64_t i = 0;
+#if defined(ROW_BCAST_HAS_NEON)
+    const float32x4_t vs = vdupq_n_f32(s);
+    if (op == ROW_BCAST_MUL) {
+        for (; i + 16 <= n; i += 16) {
+            vst1q_f32(d + i +  0, vmulq_f32(vld1q_f32(x + i +  0), vs));
+            vst1q_f32(d + i +  4, vmulq_f32(vld1q_f32(x + i +  4), vs));
+            vst1q_f32(d + i +  8, vmulq_f32(vld1q_f32(x + i +  8), vs));
+            vst1q_f32(d + i + 12, vmulq_f32(vld1q_f32(x + i + 12), vs));
+        }
+        for (; i + 4 <= n; i += 4) {
+            vst1q_f32(d + i, vmulq_f32(vld1q_f32(x + i), vs));
+        }
+    } else if (op == ROW_BCAST_ADD) {
+        for (; i + 16 <= n; i += 16) {
+            vst1q_f32(d + i +  0, vaddq_f32(vld1q_f32(x + i +  0), vs));
+            vst1q_f32(d + i +  4, vaddq_f32(vld1q_f32(x + i +  4), vs));
+            vst1q_f32(d + i +  8, vaddq_f32(vld1q_f32(x + i +  8), vs));
+            vst1q_f32(d + i + 12, vaddq_f32(vld1q_f32(x + i + 12), vs));
+        }
+        for (; i + 4 <= n; i += 4) {
+            vst1q_f32(d + i, vaddq_f32(vld1q_f32(x + i), vs));
+        }
+    } else if (op == ROW_BCAST_SUB) {
+        for (; i + 16 <= n; i += 16) {
+            vst1q_f32(d + i +  0, vsubq_f32(vld1q_f32(x + i +  0), vs));
+            vst1q_f32(d + i +  4, vsubq_f32(vld1q_f32(x + i +  4), vs));
+            vst1q_f32(d + i +  8, vsubq_f32(vld1q_f32(x + i +  8), vs));
+            vst1q_f32(d + i + 12, vsubq_f32(vld1q_f32(x + i + 12), vs));
+        }
+        for (; i + 4 <= n; i += 4) {
+            vst1q_f32(d + i, vsubq_f32(vld1q_f32(x + i), vs));
+        }
+    } else if (op == ROW_BCAST_DIV) {
+        for (; i + 16 <= n; i += 16) {
+            vst1q_f32(d + i +  0, vdivq_f32(vld1q_f32(x + i +  0), vs));
+            vst1q_f32(d + i +  4, vdivq_f32(vld1q_f32(x + i +  4), vs));
+            vst1q_f32(d + i +  8, vdivq_f32(vld1q_f32(x + i +  8), vs));
+            vst1q_f32(d + i + 12, vdivq_f32(vld1q_f32(x + i + 12), vs));
+        }
+        for (; i + 4 <= n; i += 4) {
+            vst1q_f32(d + i, vdivq_f32(vld1q_f32(x + i), vs));
+        }
+    }
+#else
+    (void) op;
+#endif
+    for (; i < n; ++i) {
+        if (op == ROW_BCAST_ADD) {
+            d[i] = x[i] + s;
+        } else if (op == ROW_BCAST_SUB) {
+            d[i] = x[i] - s;
+        } else if (op == ROW_BCAST_MUL) {
+            d[i] = x[i] * s;
+        } else {
+            d[i] = x[i] / s;
+        }
+    }
+}
diff --git a/ggml/src/ggml-cpu/situ-neon.h b/ggml/src/ggml-cpu/situ-neon.h
new file mode 100644
index 0000000..2da8fec
--- /dev/null
+++ b/ggml/src/ggml-cpu/situ-neon.h
@@ -0,0 +1,219 @@
+#pragma once
+
+// Fused SiTU: beta*tanh(gate/beta)*sigmoid(gate) * (lb>0 ? lb*tanh(up/lb) : up)
+//
+// situ_ref_f32 is libm tanhf/expf, in the same order as the old graph. It is the default.
+// GGML_SITU_FAST=accel (or 1) uses Apple vvtanhf + vvexpf on a 256-wide stack tile.
+// GGML_SITU_FAST=neon uses a higher-precision NEON path: Padé tanh for |x| < 1 and a
+// 7-term Cody-Waite exp outside that. Both are opt-in until a greedy run proves they
+// do not change tokens. Unset keeps situ_ref_f32 (SITU_FAST_DEFAULT).
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+#include <arm_neon.h>
+#define SITU_HAS_NEON 1
+#endif
+
+#if defined(GGML_USE_ACCELERATE)
+#include <Accelerate/Accelerate.h>
+#define SITU_HAS_ACCEL 1
+#endif
+
+#ifndef SITU_FAST_DEFAULT
+#define SITU_FAST_DEFAULT 0
+#endif
+
+// Same rounding steps as the old graph: scale, tanhf, scale, sigmoid(expf), mul.
+inline float situ_ref_f32(float gate, float up, float beta, float lb) {
+    const float inv_b = 1.0f / beta;
+    float act = tanhf(gate * inv_b);
+    act = act * beta;
+    act = act * (1.0f / (1.0f + expf(-gate)));
+    float lin = up;
+    if (lb > 0.0f) {
+        lin = tanhf(up * (1.0f / lb));
+        lin = lin * lb;
+    }
+    return act * lin;
+}
+
+#if defined(SITU_HAS_NEON)
+// Accurate 4-wide expf for x <= 0. Cody-Waite + 7-term polynomial on the reduced range.
+// The 7 coefficients are a degree-6 fit of exp on [-ln2/2, ln2/2] (truncation ~1e-8 in f32).
+inline float32x4_t situ_fa_exp_neg(float32x4_t x) {
+    const uint32x4_t under = vcltq_f32(x, vdupq_n_f32(-87.33654475f));
+    x = vmaxq_f32(x, vdupq_n_f32(-87.33654475f));
+    const float32x4_t log2e  = vdupq_n_f32(1.44269504088896341f);
+    const float32x4_t ln2_hi = vdupq_n_f32(0.693145751953125f);
+    const float32x4_t ln2_lo = vdupq_n_f32(1.428606765330187045e-6f);
+    float32x4_t z = vrndnq_f32(vmulq_f32(x, log2e));
+    float32x4_t r = vfmsq_f32(vfmsq_f32(x, z, ln2_hi), z, ln2_lo);
+    float32x4_t p = vdupq_n_f32(1.394462306e-3f);
+    p = vfmaq_f32(vdupq_n_f32(8.371927775e-3f), p, r);
+    p = vfmaq_f32(vdupq_n_f32(4.166628048e-2f), p, r);
+    p = vfmaq_f32(vdupq_n_f32(1.666645557e-1f), p, r);
+    p = vfmaq_f32(vdupq_n_f32(5.00000000e-1f), p, r);
+    p = vfmaq_f32(vdupq_n_f32(1.0f), p, r);
+    p = vfmaq_f32(vdupq_n_f32(1.0f), p, r);
+    int32x4_t ki = vaddq_s32(vcvtq_s32_f32(z), vdupq_n_s32(127));
+    float32x4_t pow2k = vreinterpretq_f32_s32(vshlq_n_s32(ki, 23));
+    float32x4_t res = vmulq_f32(p, pow2k);
+    return vreinterpretq_f32_u32(vbicq_u32(vreinterpretq_u32_f32(res), under));
+}
+
+// Older exp-only tanh, kept so accuracy tests can still measure it. Not used for inference.
+inline float32x4_t situ_tanh_neon(float32x4_t x) {
+    const float32x4_t ax = vminq_f32(vabsq_f32(x), vdupq_n_f32(16.0f));
+    const float32x4_t e = situ_fa_exp_neg(vnegq_f32(vmulq_n_f32(ax, 2.0f)));
+    const float32x4_t one = vdupq_n_f32(1.0f);
+    const float32x4_t th = vdivq_f32(vsubq_f32(one, e), vaddq_f32(one, e));
+    return vbslq_f32(vcltq_f32(x, vdupq_n_f32(0.0f)), vnegq_f32(th), th);
+}
+
+inline float32x4_t situ_sigmoid_neon(float32x4_t x) {
+    const float32x4_t e = situ_fa_exp_neg(vnegq_f32(vabsq_f32(x)));
+    const float32x4_t one = vdupq_n_f32(1.0f);
+    const float32x4_t sig_abs = vdivq_f32(one, vaddq_f32(one, e));
+    return vbslq_f32(vcltq_f32(x, vdupq_n_f32(0.0f)), vsubq_f32(one, sig_abs), sig_abs);
+}
+
+// Padé tanh(x) = x * P(x^2)/Q(x^2) for |x| <= 1 (float32 error ~3e-8 vs tanh).
+// |x| > 1 uses the exp identity, where cancellation is small.
+inline float32x4_t situ_tanh_hp(float32x4_t x) {
+    const float32x4_t ax = vabsq_f32(x);
+    const float32x4_t z = vmulq_f32(x, x);
+    float32x4_t num = vfmaq_f32(vdupq_n_f32(2.783945529e-3f), vdupq_n_f32(7.275152711e-6f), z);
+    num = vfmaq_f32(vdupq_n_f32(1.280855834e-1f), num, z);
+    num = vfmaq_f32(vdupq_n_f32(1.0f), num, z);
+    float32x4_t den = vfmaq_f32(vdupq_n_f32(2.325691842e-2f), vdupq_n_f32(2.053127246e-4f), z);
+    den = vfmaq_f32(vdupq_n_f32(4.614189267e-1f), den, z);
+    den = vfmaq_f32(vdupq_n_f32(1.0f), den, z);
+    const float32x4_t pade = vdivq_f32(vmulq_f32(x, num), den);
+
+    const float32x4_t axc = vminq_f32(ax, vdupq_n_f32(16.0f));
+    const float32x4_t e = situ_fa_exp_neg(vnegq_f32(vmulq_n_f32(axc, 2.0f)));
+    const float32x4_t one = vdupq_n_f32(1.0f);
+    float32x4_t th = vdivq_f32(vsubq_f32(one, e), vaddq_f32(one, e));
+    th = vbslq_f32(vcltq_f32(x, vdupq_n_f32(0.0f)), vnegq_f32(th), th);
+    return vbslq_f32(vcleq_f32(ax, vdupq_n_f32(1.0f)), pade, th);
+}
+
+inline void situ_f32x4(float * dst, const float * gate, const float * up, float beta, float lb) {
+    const float32x4_t g = vld1q_f32(gate);
+    const float32x4_t u = vld1q_f32(up);
+    float32x4_t a = vmulq_f32(situ_tanh_neon(vmulq_n_f32(g, 1.0f / beta)), vdupq_n_f32(beta));
+    a = vmulq_f32(a, situ_sigmoid_neon(g));
+    float32x4_t b = u;
+    if (lb > 0.0f) {
+        b = vmulq_f32(situ_tanh_neon(vmulq_n_f32(u, 1.0f / lb)), vdupq_n_f32(lb));
+    }
+    vst1q_f32(dst, vmulq_f32(a, b));
+}
+
+inline void situ_f32x4_hp(float * dst, const float * gate, const float * up, float beta, float lb) {
+    const float32x4_t g = vld1q_f32(gate);
+    const float32x4_t u = vld1q_f32(up);
+    float32x4_t a = vmulq_f32(situ_tanh_hp(vmulq_n_f32(g, 1.0f / beta)), vdupq_n_f32(beta));
+    a = vmulq_f32(a, situ_sigmoid_neon(g));
+    float32x4_t b = u;
+    if (lb > 0.0f) {
+        b = vmulq_f32(situ_tanh_hp(vmulq_n_f32(u, 1.0f / lb)), vdupq_n_f32(lb));
+    }
+    vst1q_f32(dst, vmulq_f32(a, b));
+}
+
+inline void situ_row_neon_hp(float * dst, const float * gate, const float * up, int n, float beta, float lb) {
+    int i = 0;
+    for (; i + 4 <= n; i += 4) {
+        situ_f32x4_hp(dst + i, gate + i, up + i, beta, lb);
+    }
+    for (; i < n; ++i) {
+        dst[i] = situ_ref_f32(gate[i], up[i], beta, lb);
+    }
+}
+#endif
+
+#if defined(SITU_HAS_ACCEL)
+// vvtanhf + vvexpf on a contiguous 256-float stack tile. Same algebra as situ_ref_f32.
+inline void situ_row_accel(float * dst, const float * gate, const float * up, int n, float beta, float lb) {
+    constexpr int T = 256;
+    float gsc[T], thg[T], eg[T], usc[T], thu[T];
+    const float inv_b = 1.0f / beta;
+    const float inv_l = lb > 0.0f ? 1.0f / lb : 0.0f;
+    for (int i = 0; i < n; ) {
+        int m = n - i;
+        if (m > T) {
+            m = T;
+        }
+        for (int j = 0; j < m; ++j) {
+            gsc[j] = gate[i + j] * inv_b;
+            eg[j] = -gate[i + j];
+        }
+        vvtanhf(thg, gsc, &m);
+        vvexpf(eg, eg, &m);
+        if (lb > 0.0f) {
+            for (int j = 0; j < m; ++j) {
+                usc[j] = up[i + j] * inv_l;
+            }
+            vvtanhf(thu, usc, &m);
+        }
+        for (int j = 0; j < m; ++j) {
+            float act = thg[j] * beta;
+            act = act * (1.0f / (1.0f + eg[j]));
+            float lin = up[i + j];
+            if (lb > 0.0f) {
+                lin = thu[j] * lb;
+            }
+            dst[i + j] = act * lin;
+        }
+        i += m;
+    }
+}
+#endif
+
+// 0 = libm, 1 = Accelerate, 2 = high-precision NEON. Unset follows SITU_FAST_DEFAULT.
+inline int situ_fast_mode() {
+    static int mode = -1;
+    if (mode >= 0) {
+        return mode;
+    }
+    const char * e = getenv("GGML_SITU_FAST");
+    if (!e || !e[0] || std::strcmp(e, "0") == 0 || std::strcmp(e, "off") == 0 || std::strcmp(e, "ref") == 0) {
+        mode = (!e || !e[0]) ? SITU_FAST_DEFAULT : 0;
+    } else if (std::strcmp(e, "neon") == 0) {
+        mode = 2;
+    } else {
+        mode = 1;
+    }
+    return mode;
+}
+
+inline void situ_row_f32(float * dst, const float * gate, const float * up, int n, float beta, float lb) {
+    const int mode = situ_fast_mode();
+#if defined(SITU_HAS_ACCEL)
+    if (mode == 1) {
+        situ_row_accel(dst, gate, up, n, beta, lb);
+        return;
+    }
+#elif defined(SITU_HAS_NEON)
+    if (mode == 1) {
+        situ_row_neon_hp(dst, gate, up, n, beta, lb);
+        return;
+    }
+#endif
+#if defined(SITU_HAS_NEON)
+    if (mode == 2) {
+        situ_row_neon_hp(dst, gate, up, n, beta, lb);
+        return;
+    }
+#else
+    (void) mode;
+#endif
+    for (int i = 0; i < n; ++i) {
+        dst[i] = situ_ref_f32(gate[i], up[i], beta, lb);
+    }
+}
