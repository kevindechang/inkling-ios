+
+static int ggml_lm_head_q4_k_interleave(void) {
+    if (ggml_cpu_has_avx2()) {
+        return 8;
+    }
+    if (ggml_cpu_has_neon() && ggml_cpu_has_matmul_int8()) {
+        return 8;
+    }
+    if (ggml_cpu_has_neon() && ggml_cpu_has_dotprod()) {
+        return 4;
+    }
+    return 0;
+}
+
+static bool ggml_lm_head_q4_k_supported(const struct ggml_tensor * w) {
+    if (!w || w->type != GGML_TYPE_Q4_K || !w->buffer) {
+        return false;
+    }
+    if (w->buffer->buft != ggml_backend_cpu_repack_buffer_type()) {
+        return false;
+    }
+    if (w->ne[0] % QK_K != 0 || w->ne[1] % 8 != 0) {
+        return false;
+    }
+    return ggml_lm_head_q4_k_interleave() != 0;
+}
+
+static void ggml_lm_head_q4_k_unrepack_row(const struct ggml_tensor * w, int64_t row, void * dst_q4_k) {
+    const int bl = ggml_lm_head_q4_k_interleave();
+    GGML_ASSERT(bl == 4 || bl == 8);
+    const int64_t nblocks = w->ne[0] / QK_K;
+    const int64_t grp = row / 8;
+    const int lane = (int) (row % 8);
+    const block_q4_Kx8 * src = (const block_q4_Kx8 *) w->data + grp * nblocks;
+    block_q4_K * out = (block_q4_K *) dst_q4_k;
+    const int chunks = (QK_K / 2) / bl;
+
+    for (int64_t x = 0; x < nblocks; ++x) {
+        out[x].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d    = src[x].d[lane];
+        out[x].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin = src[x].dmin[lane];
+        for (int c = 0; c < chunks; ++c) {
+            memcpy(&out[x].qs[c * bl], &src[x].qs[(c * 8 + lane) * bl], (size_t) bl);
+        }
+        for (int i = 0; i < 4; ++i) {
+            uint8_t s_lo, m_lo, s_hi, m_hi;
+            const uint8_t * sc0 = &src[x].scales[i * 12];
+            const uint8_t * sc1 = &src[x].scales[48 + i * 12];
+            if (lane < 4) {
+                s_lo = sc0[lane] & 63;
+                m_lo = sc0[4 + lane] & 63;
+                s_hi = sc1[lane] & 63;
+                m_hi = sc1[4 + lane] & 63;
+            } else {
+                const int l = lane - 4;
+                s_lo = ((sc0[l] & 192) >> 2) | (sc0[8 + l] & 15);
+                m_lo = ((sc0[4 + l] & 192) >> 2) | ((sc0[8 + l] & 240) >> 4);
+                s_hi = ((sc1[l] & 192) >> 2) | (sc1[8 + l] & 15);
+                m_hi = ((sc1[4 + l] & 192) >> 2) | ((sc1[8 + l] & 240) >> 4);
+            }
+            out[x].scales[i]     = (s_lo & 63) | ((s_hi & 48) << 2);
+            out[x].scales[i + 4] = (m_lo & 63) | ((m_hi & 48) << 2);
+            out[x].scales[i + 8] = (s_hi & 15) | ((m_hi & 15) << 4);
+        }
+    }
+}
+
+static void ggml_lm_head_q4_k_repack_rows(int64_t ne0, int64_t n_rows, const void * src_q4_k, void * dst_repacked) {
+    const int bl = ggml_lm_head_q4_k_interleave();
+    GGML_ASSERT((bl == 4 || bl == 8) && (n_rows % 8 == 0));
+    struct ggml_tensor t;
+    memset(&t, 0, sizeof(t));
+    t.type  = GGML_TYPE_Q4_K;
+    t.ne[0] = ne0;
+    t.ne[1] = n_rows;
+    t.ne[2] = 1;
+    t.ne[3] = 1;
+    t.data  = dst_repacked;
+    const size_t data_size = (size_t) n_rows * ggml_row_size(GGML_TYPE_Q4_K, ne0);
+    const int rc = repack_q4_K_to_q4_K_8_bl(&t, bl, src_q4_k, data_size);
+    GGML_ASSERT(rc == 0);
+}
+
+static void ggml_lm_head_q4_k_quantize_h(int64_t ne0, const float * h_f32, void * dst_q8_k) {
+    ggml_get_type_traits_cpu(GGML_TYPE_Q8_K)->from_float(h_f32, dst_q8_k, ne0);
+}
+
+static void ggml_lm_head_q8_k_dequant(int64_t ne0, const void * src_q8_k, float * dst_f32) {
+    const int64_t nb = ne0 / QK_K;
+    const block_q8_K * b = (const block_q8_K *) src_q8_k;
+    for (int64_t i = 0; i < nb; ++i) {
+        const float d = b[i].d;
+        for (int j = 0; j < QK_K; ++j) {
+            dst_f32[i * QK_K + j] = d * (float) b[i].qs[j];
+        }
+    }
+}
+
+static void ggml_lm_head_q4_k_gemv_rows(int64_t ne0, int64_t total_rows, const void * repacked_w,
+                                        int64_t row_start, int64_t n_rows, const void * src_q8_k, float * dst) {
+    GGML_ASSERT((row_start % 8 == 0) && (n_rows % 8 == 0));
+    const int bl = ggml_lm_head_q4_k_interleave();
+    const size_t row_sz = ggml_row_size(GGML_TYPE_Q4_K, ne0);
+    const char * base = (const char *) repacked_w + (size_t) row_start * row_sz;
+    if (bl == 8) {
+        ggml_gemv_q4_K_8x8_q8_K((int) ne0, dst, (size_t) total_rows, base, src_q8_k, 1, (int) n_rows);
+    } else {
+        ggml_gemv_q4_K_8x4_q8_K((int) ne0, dst, (size_t) total_rows, base, src_q8_k, 1, (int) n_rows);
+    }
+}
+
+const struct ggml_cpu_lm_head_ops * ggml_cpu_lm_head_get_ops(void) {
+    static const struct ggml_cpu_lm_head_ops ops = {
+        /* .q4_k_repack_supported = */ ggml_lm_head_q4_k_supported,
+        /* .q4_k_unrepack_row     = */ ggml_lm_head_q4_k_unrepack_row,
+        /* .q4_k_repack_rows      = */ ggml_lm_head_q4_k_repack_rows,
+        /* .q4_k_quantize_h       = */ ggml_lm_head_q4_k_quantize_h,
+        /* .q8_k_dequant          = */ ggml_lm_head_q8_k_dequant,
+        /* .q4_k_gemv_rows        = */ ggml_lm_head_q4_k_gemv_rows,
+    };
+    return &ops;
+}
+
+} // extern "C"
