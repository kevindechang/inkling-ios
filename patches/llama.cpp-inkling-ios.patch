+static void mmid_port_init(void) {
+    mmid_overlap = mmid_env("GGML_MMID_OVERLAP") == 1;
+    mmid_lru = mmid_env("GGML_MMID_LRU"); if (mmid_lru < 0 || mmid_lru > 2) { mmid_lru = 0; }
