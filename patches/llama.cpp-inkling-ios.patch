+// Opt-in greedy LM-head shortlist with provably exact certificate + fallback (LLAMA_LM_HEAD_SHORTLIST).
+struct llama_lm_head_shortlist {
+    enum mode_t {
+        MODE_OFF = 0,
+        MODE_EXACT_NORM = 1,
+        MODE_EXACT_CLUSTER = 2,
+        MODE_LOSSY_PURE = 3,
+        MODE_LOSSY_MARGIN = 4,
+        MODE_EXACT_FUSED = 5,
+    };
+
+    struct worker_pool {
+        std::vector<std::thread> workers;
+        std::mutex mtx;
+        std::condition_variable cv_start;
+        std::condition_variable cv_done;
+        const std::function<void(int, int)> * cur_fn = nullptr;
+        int cur_nth = 1;
+        uint64_t gen = 0;
+        int done = 0;
+        bool stop = false;
+
+        ~worker_pool() { shutdown(); }
+
+        void shutdown() {
+            {
+                std::lock_guard<std::mutex> lk(mtx);
+                stop = true;
+                cur_fn = nullptr;
+                gen++;
+            }
+            cv_start.notify_all();
+            for (auto & th : workers) {
+                if (th.joinable()) th.join();
+            }
+            workers.clear();
+            stop = false;
+        }
+
+        void ensure(int nth) {
+            const int want = std::max(0, nth - 1);
+            if ((int) workers.size() == want) return;
+            shutdown();
+            uint64_t init_gen = 0;
+            {
+                std::lock_guard<std::mutex> lk(mtx);
+                init_gen = gen;
+            }
+            for (int w = 0; w < want; ++w) {
+                const int tid = w + 1;
+                workers.emplace_back([this, tid, init_gen]() {
+#if defined(__APPLE__)
+                    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+#endif
+                    uint64_t seen = init_gen;
+                    for (;;) {
+                        const std::function<void(int, int)> * fn = nullptr;
+                        int nth_run = 1;
+                        {
+                            std::unique_lock<std::mutex> lk(mtx);
+                            cv_start.wait(lk, [&]() { return gen != seen; });
+                            seen = gen;
+                            if (stop) return;
+                            fn = cur_fn;
+                            nth_run = cur_nth;
+                        }
+                        if (tid < nth_run && fn) {
+                            (*fn)(tid, nth_run);
+                        }
+                        {
+                            std::lock_guard<std::mutex> lk(mtx);
+                            done++;
+                            if (done == (int) workers.size()) {
+                                cv_done.notify_one();
+                            }
+                        }
+                    }
+                });
+            }
+        }
+
+        void run(int nth, const std::function<void(int, int)> & fn) {
+            if (nth <= 1) {
+                fn(0, 1);
+                return;
+            }
+            ensure(nth);
+            {
+                std::lock_guard<std::mutex> lk(mtx);
+                cur_fn  = &fn;
+                cur_nth = nth;
+                done    = 0;
+                gen++;
+            }
+            cv_start.notify_all();
+            fn(0, nth);
+            {
+                std::unique_lock<std::mutex> lk(mtx);
+                cv_done.wait(lk, [&]() { return done == (int) workers.size(); });
+            }
+        }
+    };
+
+    mode_t mode = MODE_OFF;
+    const ggml_cpu_lm_head_ops * ops = nullptr;
+    const ggml_tensor * w = nullptr;
+    int64_t ne0 = 0;
+    int64_t n_vocab = 0;
+    int64_t n_vocab_padded = 0;
+    float softcap = 0.0f;
+    float inv_softcap = 0.0f;
+    float lossy_logit_th = 26.0f;
+    float lossy_margin_th = 1.0f;
+    bool print_stats = false;
+    // LLAMA_LM_HEAD_AUDIT=1 always returns the full-vocab argmax and counts whether the shortlist matched.
+    bool audit = false;
+    uint64_t n_audit_match = 0;
+    uint64_t n_audit_skip_mismatch = 0;
+
+    std::vector<llama_token> sl_ids;
+    std::vector<uint8_t>     sl_repacked;
+    std::vector<float>       sl_logits;
+    std::vector<float>       full_logits;
+    std::vector<uint8_t>     h_q8_k;
+    std::vector<float>       h_deq;
+
+    // exact certificate data
+    std::vector<double> w_mean;
+    double max_r_non_sl = 0.0;
+    int n_clusters = 0;
+    std::vector<float>  cl_centroids; // [n_clusters * ne0], centered around w_mean
+    std::vector<double> cl_radii;     // [n_clusters], exact max residual norm + fp safety
+    std::vector<int>    cl_counts;
+
+    worker_pool pool;
+
+    // stats
+    uint64_t n_calls = 0;
+    uint64_t n_skip = 0;
+    uint64_t n_fallback = 0;
+    double   sl_us = 0.0;
+    double   cert_us = 0.0;
+    double   fb_us = 0.0;
+    double   min_ub_excess = 1e30;
+
+    static const char * mode_name(mode_t m) {
+        switch (m) {
+            case MODE_EXACT_NORM:    return "exact_norm";
+            case MODE_EXACT_CLUSTER: return "exact_cluster";
+            case MODE_LOSSY_PURE:    return "lossy";
+            case MODE_LOSSY_MARGIN:  return "lossy_margin";
+            case MODE_EXACT_FUSED:   return "exact_fused";
+            default:                 return "off";
+        }
+    }
+
+    static mode_t parse_env_mode() {
+        const char * v = getenv("LLAMA_LM_HEAD_SHORTLIST");
+        if (!v || !v[0] || strcmp(v, "0") == 0 || strcmp(v, "off") == 0) {
+            return MODE_OFF;
+        }
+        if (strcmp(v, "1") == 0 || strcmp(v, "exact") == 0 || strcmp(v, "norm") == 0) {
+            return MODE_EXACT_NORM;
+        }
+        if (strcmp(v, "cluster") == 0) {
+            return MODE_EXACT_CLUSTER;
+        }
+        if (strcmp(v, "lossy") == 0) {
+            return MODE_LOSSY_PURE;
+        }
+        if (strcmp(v, "lossy_margin") == 0) {
+            return MODE_LOSSY_MARGIN;
+        }
+        if (strcmp(v, "fused") == 0) {
+            return MODE_EXACT_FUSED;
+        }
+        LLAMA_LOG_WARN("%s: unknown LLAMA_LM_HEAD_SHORTLIST='%s', disabling\n", __func__, v);
+        return MODE_OFF;
+    }
+
+    inline float apply_softcap(float x) const {
+        return softcap != 0.0f ? softcap * tanhf(x * inv_softcap) : x;
+    }
+
+    ~llama_lm_head_shortlist() {
+        pool.shutdown();
+        if (print_stats && n_calls > 0) {
+            const double tot_ms = (sl_us + cert_us + fb_us) / 1000.0;
+            const double fb_pct = 100.0 * (double) n_fallback / (double) n_calls;
+            fprintf(stderr,
+                "[head] mode=%s K=%zu vocab=%lld calls=%llu skip=%llu fallback=%llu fb_rate=%.2f%% "
+                "head_ms=%.2f (sl_ms=%.2f cert_ms=%.2f fb_ms=%.2f) avg_ms=%.3f min_ub_excess=%.3f\n",
+                mode_name(mode), sl_ids.size(), (long long) n_vocab,
+                (unsigned long long) n_calls, (unsigned long long) n_skip, (unsigned long long) n_fallback,
+                fb_pct, tot_ms, sl_us / 1000.0, cert_us / 1000.0, fb_us / 1000.0,
+                tot_ms / (double) n_calls, min_ub_excess < 1e20 ? min_ub_excess : 0.0);
+            fflush(stderr);
+            if (audit) {
+                const double skip_rate = (double) n_skip / (double) n_calls;
+                const double match_pct = 100.0 * (double) n_audit_match / (double) n_calls;
+                const double sl_ms = sl_us / 1000.0 / (double) n_calls;
+                const double full_ms = fb_us / 1000.0 / (double) n_calls;
+                const double hyp_ms = sl_ms + cert_us / 1000.0 / (double) n_calls + (1.0 - skip_rate) * full_ms;
+                fprintf(stderr,
+                    "[head-audit] mode=%s K=%zu logit_th=%.1f margin_th=%.1f calls=%llu "
+                    "match=%llu match_pct=%.4f%% skip=%llu skip_pct=%.2f%% skip_mismatch=%llu "
+                    "sl_ms=%.3f full_ms=%.3f hyp_ms=%.3f\n",
+                    mode_name(mode), sl_ids.size(), lossy_logit_th, lossy_margin_th,
+                    (unsigned long long) n_calls,
+                    (unsigned long long) n_audit_match, match_pct,
+                    (unsigned long long) n_skip, 100.0 * skip_rate,
+                    (unsigned long long) n_audit_skip_mismatch,
+                    sl_ms, full_ms, hyp_ms);
+                fflush(stderr);
+            }
+        }
+    }
+
+    bool init(const ggml_cpu_lm_head_ops * ops_in, const ggml_tensor * w_in, int64_t n_vocab_in, float softcap_in, int n_threads) {
+        mode = parse_env_mode();
+        if (mode == MODE_OFF) {
+            return false;
+        }
+        if (!ops_in || !ops_in->q4_k_repack_supported(w_in)) {
+            LLAMA_LOG_WARN("%s: output.weight is not Q4_K CPU_REPACK, disabling shortlist\n", __func__);
+            return false;
+        }
+
+        ops            = ops_in;
+        w              = w_in;
+        ne0            = w->ne[0];
+        n_vocab_padded = w->ne[1];
+        n_vocab        = std::min<int64_t>(n_vocab_in, n_vocab_padded);
+        softcap        = softcap_in;
+        inv_softcap    = softcap != 0.0f ? 1.0f / softcap : 0.0f;
+
+        if (const char * s = getenv("LLAMA_LM_HEAD_STATS")) {
+            print_stats = atoi(s) != 0;
+        }
+        if (const char * s = getenv("LLAMA_LM_HEAD_AUDIT")) {
+            audit = atoi(s) != 0;
+            if (audit) {
+                print_stats = true;
+            }
+        }
+        if (const char * s = getenv("LLAMA_LM_HEAD_LOSSY_LOGIT")) {
+            lossy_logit_th = (float) atof(s);
+        }
+        if (const char * s = getenv("LLAMA_LM_HEAD_LOSSY_MARGIN")) {
+            lossy_margin_th = (float) atof(s);
+        }
+
+        if (mode == MODE_EXACT_FUSED) {
+            full_logits.resize((size_t) n_vocab_padded);
+            h_q8_k.resize(ggml_row_size(GGML_TYPE_Q8_K, ne0));
+            fprintf(stderr, "[head] init mode=exact_fused (EXACT, 0 shortlist overhead) vocab=%lld\n", (long long) n_vocab);
+            fflush(stderr);
+            return true;
+        }
+
+        int64_t k_req = 8192;
+        if (const char * s = getenv("LLAMA_LM_HEAD_SHORTLIST_K")) {
+            k_req = std::max<int64_t>(8, atoi(s));
+        }
+        const int64_t max_sl = (n_vocab / 8) * 8;
+        k_req = std::min<int64_t>((k_req + 7) & ~7LL, max_sl);
+
+        std::vector<uint8_t> in_sl((size_t) n_vocab, 0);
+        sl_ids.reserve((size_t) k_req);
+        if (const char * path = getenv("LLAMA_LM_HEAD_SHORTLIST_FILE")) {
+            std::ifstream f(path);
+            if (!f) {
+                LLAMA_LOG_WARN("%s: failed to open LLAMA_LM_HEAD_SHORTLIST_FILE='%s', falling back to 0..K-1\n", __func__, path);
+            } else {
+                int64_t tid = 0;
+                while ((int64_t) sl_ids.size() < k_req && (f >> tid)) {
+                    if (tid >= 0 && tid < n_vocab && !in_sl[(size_t) tid]) {
+                        in_sl[(size_t) tid] = 1;
+                        sl_ids.push_back((llama_token) tid);
+                    }
+                }
+            }
+        }
+        for (int64_t tid = 0; (int64_t) sl_ids.size() < k_req && tid < n_vocab; ++tid) {
+            if (!in_sl[(size_t) tid]) {
+                in_sl[(size_t) tid] = 1;
+                sl_ids.push_back((llama_token) tid);
+            }
+        }
+        // ensure exact multiple of 8
+        sl_ids.resize(sl_ids.size() & ~(size_t) 7);
+        if (sl_ids.empty()) {
+            return false;
+        }
+
+        const int64_t t0 = ggml_time_us();
+        const size_t row_sz = ggml_row_size(GGML_TYPE_Q4_K, ne0);
+        std::vector<uint8_t> sl_raw(sl_ids.size() * row_sz);
+        for (size_t i = 0; i < sl_ids.size(); ++i) {
+            ops->q4_k_unrepack_row(w, sl_ids[i], sl_raw.data() + i * row_sz);
+        }
+        sl_repacked.resize(sl_ids.size() * row_sz);
+        ops->q4_k_repack_rows(ne0, (int64_t) sl_ids.size(), sl_raw.data(), sl_repacked.data());
+        sl_raw.clear();
+        sl_raw.shrink_to_fit();
+
+        sl_logits.resize(sl_ids.size());
+        full_logits.resize((size_t) n_vocab_padded);
+        h_q8_k.resize(ggml_row_size(GGML_TYPE_Q8_K, ne0));
+        h_deq.resize((size_t) ne0);
+
+        if (mode == MODE_EXACT_NORM || mode == MODE_EXACT_CLUSTER) {
+            const auto * q4_traits = ggml_get_type_traits(GGML_TYPE_Q4_K);
+            const double eps_fp = 1e-4; // conservative bound on 81 F32 FMAs in q4_K_8x{8,4}
+            w_mean.assign((size_t) ne0, 0.0);
+
+            std::vector<uint8_t> tmp_q4(row_sz);
+            std::vector<float>   tmp_f((size_t) ne0);
+            int64_t n_non_sl = 0;
+            for (int64_t r = 0; r < n_vocab; ++r) {
+                if (in_sl[(size_t) r]) continue;
+                ops->q4_k_unrepack_row(w, r, tmp_q4.data());
+                q4_traits->to_float(tmp_q4.data(), tmp_f.data(), ne0);
+                for (int64_t j = 0; j < ne0; ++j) {
+                    w_mean[(size_t) j] += (double) tmp_f[(size_t) j];
+                }
+                n_non_sl++;
+            }
+            if (n_non_sl > 0) {
+                const double inv = 1.0 / (double) n_non_sl;
+                for (int64_t j = 0; j < ne0; ++j) {
+                    w_mean[(size_t) j] *= inv;
+                }
+            }
+
+            if (mode == MODE_EXACT_NORM) {
+                max_r_non_sl = 0.0;
+                for (int64_t r = 0; r < n_vocab; ++r) {
+                    if (in_sl[(size_t) r]) continue;
+                    ops->q4_k_unrepack_row(w, r, tmp_q4.data());
+                    q4_traits->to_float(tmp_q4.data(), tmp_f.data(), ne0);
+                    double c2 = 0.0, w2 = 0.0;
+                    for (int64_t j = 0; j < ne0; ++j) {
+                        const double x = (double) tmp_f[(size_t) j];
+                        const double d = x - w_mean[(size_t) j];
+                        c2 += d * d;
+                        w2 += x * x;
+                    }
+                    const double bound_r = sqrt(c2) + eps_fp * sqrt(w2);
+                    if (bound_r > max_r_non_sl) max_r_non_sl = bound_r;
+                }
+            } else {
+                n_clusters = 64;
+                if (const char * s = getenv("LLAMA_LM_HEAD_CLUSTERS")) {
+                    n_clusters = std::max(1, std::min(1024, atoi(s)));
+                }
+                cl_centroids.assign((size_t) n_clusters * (size_t) ne0, 0.0f);
+                // deterministic strided init from non-shortlist rows
+                const int64_t stride = std::max<int64_t>(1, n_non_sl / n_clusters);
+                int64_t seen = 0;
+                int picked = 0;
+                for (int64_t r = 0; r < n_vocab && picked < n_clusters; ++r) {
+                    if (in_sl[(size_t) r]) continue;
+                    if (seen % stride == 0) {
+                        ops->q4_k_unrepack_row(w, r, tmp_q4.data());
+                        q4_traits->to_float(tmp_q4.data(), tmp_f.data(), ne0);
+                        float * dst_c = cl_centroids.data() + (size_t) picked * (size_t) ne0;
+                        for (int64_t j = 0; j < ne0; ++j) {
+                            dst_c[j] = (float) ((double) tmp_f[(size_t) j] - w_mean[(size_t) j]);
+                        }
+                        picked++;
+                    }
+                    seen++;
+                }
+                n_clusters = picked;
+                const int nth = std::max(1, n_threads);
+
+                // 1 k-means centroid update pass (parallel)
+                std::vector<float> c_norm2((size_t) n_clusters, 0.0f);
+                for (int k = 0; k < n_clusters; ++k) {
+                    const float * c = cl_centroids.data() + (size_t) k * (size_t) ne0;
+                    double s = 0.0;
+                    for (int64_t j = 0; j < ne0; ++j) s += (double) c[j] * (double) c[j];
+                    c_norm2[(size_t) k] = (float) s;
+                }
+                std::vector<std::vector<double>> thr_sums((size_t) nth, std::vector<double>((size_t) n_clusters * (size_t) ne0, 0.0));
+                std::vector<std::vector<int>>    thr_cnts((size_t) nth, std::vector<int>((size_t) n_clusters, 0));
+                pool.run(nth, [&](int tid, int nt) {
+                    const int64_t r0 = (n_vocab * tid) / nt;
+                    const int64_t r1 = (n_vocab * (tid + 1)) / nt;
+                    std::vector<uint8_t> lq4(row_sz);
+                    std::vector<float>   lf((size_t) ne0);
+                    auto & sums = thr_sums[(size_t) tid];
+                    auto & cnts = thr_cnts[(size_t) tid];
+                    for (int64_t r = r0; r < r1; ++r) {
+                        if (in_sl[(size_t) r]) continue;
+                        ops->q4_k_unrepack_row(w, r, lq4.data());
+                        q4_traits->to_float(lq4.data(), lf.data(), ne0);
+                        for (int64_t j = 0; j < ne0; ++j) lf[(size_t) j] -= (float) w_mean[(size_t) j];
+                        int best_k = 0;
+                        float best_sc = -1e30f;
+                        for (int k = 0; k < n_clusters; ++k) {
+                            const float * c = cl_centroids.data() + (size_t) k * (size_t) ne0;
+                            float dot = 0.0f;
+                            for (int64_t j = 0; j < ne0; ++j) dot += lf[(size_t) j] * c[j];
+                            const float sc = 2.0f * dot - c_norm2[(size_t) k];
+                            if (sc > best_sc) { best_sc = sc; best_k = k; }
+                        }
+                        cnts[(size_t) best_k]++;
+                        double * dst_s = sums.data() + (size_t) best_k * (size_t) ne0;
+                        for (int64_t j = 0; j < ne0; ++j) dst_s[j] += (double) lf[(size_t) j];
+                    }
+                });
+                for (int k = 0; k < n_clusters; ++k) {
+                    int tot = 0;
+                    for (int t = 0; t < nth; ++t) tot += thr_cnts[(size_t) t][(size_t) k];
+                    if (tot > 0) {
+                        float * dst_c = cl_centroids.data() + (size_t) k * (size_t) ne0;
+                        const double inv = 1.0 / (double) tot;
+                        for (int64_t j = 0; j < ne0; ++j) {
+                            double s = 0.0;
+                            for (int t = 0; t < nth; ++t) s += thr_sums[(size_t) t][(size_t) k * (size_t) ne0 + (size_t) j];
+                            dst_c[j] = (float) (s * inv);
+                        }
+                    }
+                }
+                for (int k = 0; k < n_clusters; ++k) {
+                    const float * c = cl_centroids.data() + (size_t) k * (size_t) ne0;
+                    double s = 0.0;
+                    for (int64_t j = 0; j < ne0; ++j) s += (double) c[j] * (double) c[j];
+                    c_norm2[(size_t) k] = (float) s;
+                }
+
+                // exact radius pass: every non-shortlist row covered by its assigned cluster's max radius
+                cl_radii.assign((size_t) n_clusters, 0.0);
+                cl_counts.assign((size_t) n_clusters, 0);
+                std::vector<std::vector<double>> thr_rad((size_t) nth, std::vector<double>((size_t) n_clusters, 0.0));
+                std::vector<std::vector<int>>    thr_cnt2((size_t) nth, std::vector<int>((size_t) n_clusters, 0));
+                pool.run(nth, [&](int tid, int nt) {
+                    const int64_t r0 = (n_vocab * tid) / nt;
+                    const int64_t r1 = (n_vocab * (tid + 1)) / nt;
+                    std::vector<uint8_t> lq4(row_sz);
+                    std::vector<float>   lf((size_t) ne0);
+                    auto & rad  = thr_rad[(size_t) tid];
+                    auto & cnts = thr_cnt2[(size_t) tid];
+                    for (int64_t r = r0; r < r1; ++r) {
+                        if (in_sl[(size_t) r]) continue;
+                        ops->q4_k_unrepack_row(w, r, lq4.data());
+                        q4_traits->to_float(lq4.data(), lf.data(), ne0);
+                        int best_k = 0;
+                        float best_sc = -1e30f;
+                        for (int k = 0; k < n_clusters; ++k) {
+                            const float * c = cl_centroids.data() + (size_t) k * (size_t) ne0;
+                            float dot = 0.0f;
+                            for (int64_t j = 0; j < ne0; ++j) dot += (lf[(size_t) j] - (float) w_mean[(size_t) j]) * c[j];
+                            const float sc = 2.0f * dot - c_norm2[(size_t) k];
+                            if (sc > best_sc) { best_sc = sc; best_k = k; }
+                        }
+                        const float * c = cl_centroids.data() + (size_t) best_k * (size_t) ne0;
+                        double d2 = 0.0, w2 = 0.0;
+                        for (int64_t j = 0; j < ne0; ++j) {
+                            const double x = (double) lf[(size_t) j];
+                            const double d = x - w_mean[(size_t) j] - (double) c[j];
+                            d2 += d * d;
+                            w2 += x * x;
+                        }
+                        const double br = sqrt(d2) + eps_fp * sqrt(w2);
+                        if (br > rad[(size_t) best_k]) rad[(size_t) best_k] = br;
+                        cnts[(size_t) best_k]++;
+                    }
+                });
+                for (int k = 0; k < n_clusters; ++k) {
+                    for (int t = 0; t < nth; ++t) {
+                        cl_counts[(size_t) k] += thr_cnt2[(size_t) t][(size_t) k];
+                        if (thr_rad[(size_t) t][(size_t) k] > cl_radii[(size_t) k]) {
+                            cl_radii[(size_t) k] = thr_rad[(size_t) t][(size_t) k];
+                        }
+                    }
+                }
+            }
+        }
+
+        const double init_ms = (ggml_time_us() - t0) / 1000.0;
+        if (mode == MODE_LOSSY_PURE || mode == MODE_LOSSY_MARGIN) {
+            fprintf(stderr, "[head] WARNING: LOSSY mode=%s (NOT exact) K=%zu init_ms=%.1f\n",
+                    mode_name(mode), sl_ids.size(), init_ms);
+        } else {
+            fprintf(stderr, "[head] init mode=%s (EXACT) K=%zu max_r=%.4f clusters=%d init_ms=%.1f\n",
+                    mode_name(mode), sl_ids.size(), max_r_non_sl, n_clusters, init_ms);
+        }
+        fflush(stderr);
+        return true;
+    }
+
+    llama_token eval_greedy(const float * h_f32, int n_threads) {
+        n_calls++;
+        const int nth = std::max(1, n_threads);
+        llama_token sl_best = 0;
+        bool have_sl = false;
+        bool would_skip = false;
+
+        const int64_t t0 = ggml_time_us();
+        ops->q4_k_quantize_h(ne0, h_f32, h_q8_k.data());
+
+        int64_t t2 = t0;
+        if (mode != MODE_EXACT_FUSED) {
+            // 1. Shortlist GEMV (parallel across nth threads, exact same Q4_K kernel as full head)
+            const int64_t sl_n = (int64_t) sl_ids.size();
+            pool.run(nth, [&](int tid, int nt) {
+                int64_t r0 = ((sl_n * tid) / nt) & ~7LL;
+                int64_t r1 = (tid + 1 == nt) ? sl_n : (((sl_n * (tid + 1)) / nt) & ~7LL);
+                if (r1 > r0) {
+                    ops->q4_k_gemv_rows(ne0, sl_n, sl_repacked.data(), r0, r1 - r0, h_q8_k.data(), sl_logits.data() + r0);
+                }
+            });
+
+            llama_token best_tok = sl_ids[0];
+            float best_raw  = sl_logits[0];
+            float best_soft = apply_softcap(best_raw);
+            float second_soft = -INFINITY;
+            for (int64_t i = 1; i < sl_n; ++i) {
+                const float raw = sl_logits[(size_t) i];
+                const float soft = apply_softcap(raw);
+                const llama_token tok = sl_ids[(size_t) i];
+                if (soft > best_soft || (soft == best_soft && tok < best_tok)) {
+                    second_soft = best_soft;
+                    best_soft   = soft;
+                    best_raw    = raw;
+                    best_tok    = tok;
+                } else if (soft > second_soft) {
+                    second_soft = soft;
+                }
+            }
+            const int64_t t1 = ggml_time_us();
+            sl_us += (double) (t1 - t0);
+
+            // 2. Certificate / heuristic check
+            bool skip_full = false;
+            if (mode == MODE_LOSSY_PURE) {
+                skip_full = true;
+            } else if (mode == MODE_LOSSY_MARGIN) {
+                skip_full = (best_soft >= lossy_logit_th) && ((best_soft - second_soft) >= lossy_margin_th);
+            } else {
+                ops->q8_k_dequant(ne0, h_q8_k.data(), h_deq.data());
+                double h2 = 0.0, mean_dot = 0.0;
+                for (int64_t j = 0; j < ne0; ++j) {
+                    const double hj = (double) h_deq[(size_t) j];
+                    h2 += hj * hj;
+                    mean_dot += w_mean[(size_t) j] * hj;
+                }
