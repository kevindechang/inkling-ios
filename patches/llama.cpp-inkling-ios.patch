+void ggml_arm_repack_iq1_s_4x4(void * GGML_RESTRICT dst_v, const void * GGML_RESTRICT src_v, int64_t ne0, int64_t ne1) {
+    init_mmid_repack_luts();
+    const int64_t nb = ne0 / QK_K;
+    const block_iq1_s * src = (const block_iq1_s *) src_v;
+    block_iq1_sx4 * dst = (block_iq1_sx4 *) dst_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            block_iq1_sx4 out;
+            for (int i = 0; i < 4; ++i) {
+                const block_iq1_s & in = src[(r + i) * nb + b];
+                out.d[i] = in.d;
+                for (int ib = 0; ib < 8; ++ib) {
+                    const uint16_t qh = in.qh[ib];
+                    const int ls = 2 * ((qh >> 12) & 7) + 1;
+                    out.ls_sgn[ib * 4 + i] = (int8_t) ((qh & 0x8000) ? -ls : ls);
+                    const uint16_t idx0 = (uint16_t) (in.qs[ib * 4 + 0] | ((qh << 8) & 0x700));
+                    const uint16_t idx1 = (uint16_t) (in.qs[ib * 4 + 1] | ((qh << 5) & 0x700));
+                    const uint16_t idx2 = (uint16_t) (in.qs[ib * 4 + 2] | ((qh << 2) & 0x700));
+                    const uint16_t idx3 = (uint16_t) (in.qs[ib * 4 + 3] | ((qh >> 1) & 0x700));
+                    const pair_u32 p0 = g_iq1s_lut[idx0];
+                    const pair_u32 p1 = g_iq1s_lut[idx1];
+                    const pair_u32 p2 = g_iq1s_lut[idx2];
+                    const pair_u32 p3 = g_iq1s_lut[idx3];
+                    uint32_t v0 = p0.lo4 | (p0.hi4 << 2) | (p1.lo4 << 4) | (p1.hi4 << 6);
+                    uint32_t v1 = p2.lo4 | (p2.hi4 << 2) | (p3.lo4 << 4) | (p3.hi4 << 6);
+                    memcpy(out.qs + ib * 32 + 0  + i * 4, &v0, 4);
+                    memcpy(out.qs + ib * 32 + 16 + i * 4, &v1, 4);
+                }
+            }
+            *dst++ = out;
+        }
+    }
+}
