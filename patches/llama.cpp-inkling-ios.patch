+static void mmid_unmake_q4_Kx8(block_q4_K * out, const block_q4_Kx8 * in, int inter) {
+    for (int i = 0; i < 8; i++) {
+        out[i].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d    = in->d[i];
+        out[i].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin = in->dmin[i];
+    }
+    const int end = QK_K * 4 / inter;
+    for (int i = 0; i < end; ++i) {
+        const int src_id = i % 8;
+        const int src_offset = (i / 8) * inter;
+        const int dst_offset = i * inter;
+        memcpy(&out[src_id].qs[src_offset], &in->qs[dst_offset], (size_t) inter);
+    }
+    for (int g = 0; g < 4; ++g) {
+        uint8_t s_lo[8], m_lo[8], s_hi[8], m_hi[8];
+        mmid_unpack_q4k_12(in->scales + g * 12, s_lo, m_lo);
+        mmid_unpack_q4k_12(in->scales + 48 + g * 12, s_hi, m_hi);
+        for (int j = 0; j < 8; ++j) {
+            out[j].scales[g]     = (uint8_t) ((s_lo[j] & 63) | ((s_hi[j] & 48) << 2));
+            out[j].scales[g + 4] = (uint8_t) ((m_lo[j] & 63) | ((m_hi[j] & 48) << 2));
+            out[j].scales[g + 8] = (uint8_t) ((s_hi[j] & 15) | ((m_hi[j] & 15) << 4));
+        }
+    }
+}
+
+static void mmid_unmake_q4_0x4(block_q4_0 * out, const block_q4_0x4 * in, int inter) {
+    for (int i = 0; i < 4; i++) out[i].d = in->d[i];
+    const int end = QK4_0 * 2 / inter;
+    if (inter == 8) {
+        const uint64_t xor_mask = 0x8888888888888888ULL;
+        for (int i = 0; i < end; ++i) {
+            const int src_id = i % 4;
+            const int src_offset = (i / 4) * inter;
+            const int dst_offset = i * inter;
+            uint64_t elems;
+            memcpy(&elems, &in->qs[dst_offset], sizeof elems);
+            elems ^= xor_mask;
+            memcpy(&out[src_id].qs[src_offset], &elems, sizeof elems);
+        }
+    } else {
+        const uint32_t xor_mask = 0x88888888u;
+        for (int i = 0; i < end; ++i) {
+            const int src_id = i % 4;
+            const int src_offset = (i / 4) * inter;
+            const int dst_offset = i * inter;
+            uint32_t elems;
+            memcpy(&elems, &in->qs[dst_offset], sizeof elems);
+            elems ^= xor_mask;
+            memcpy(&out[src_id].qs[src_offset], &elems, sizeof elems);
+        }
+    }
+}
+
+static void mmid_unmake_iq4_nlx4(block_iq4_nl * out, const block_iq4_nlx4 * in) {
+    const int inter = 4;
+    for (int i = 0; i < 4; i++) out[i].d = in->d[i];
+    const int end = QK4_NL * 2 / inter;
+    for (int i = 0; i < end; ++i) {
+        const int src_id = i % 4;
+        const int src_offset = (i / 4) * inter;
+        const int dst_offset = i * inter;
+        memcpy(&out[src_id].qs[src_offset], &in->qs[dst_offset], sizeof(uint32_t));
+    }
+}
