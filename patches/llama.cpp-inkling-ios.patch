+void ggml_arm_gemv_q2_K_4x4_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    const int nb = n / QK_K;
+    const block_q2_Kx4 * b_ptr = (const block_q2_Kx4 *) vx;
+    const block_q8_K * a_base = (const block_q8_K *) vy;
+    const uint8x16_t m3 = vdupq_n_u8(0x03);
+    for (int c = 0; c < nc; c += 4) {
+        float32x4_t acc = vdupq_n_f32(0.0f);
+        for (int b = 0; b < nb; ++b) {
+            const block_q8_K * ap = &a_base[b];
+            int32x4_t msum = vdupq_n_s32(0);
+            for (int is = 0; is < 16; ++is) {
+                const uint8_t * sp = b_ptr->scales + is * 4;
+                int32x4_t mv = { (int32_t)(sp[0] >> 4), (int32_t)(sp[1] >> 4), (int32_t)(sp[2] >> 4), (int32_t)(sp[3] >> 4) };
