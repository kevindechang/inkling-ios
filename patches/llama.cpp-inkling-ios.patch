+void ggml_arm_repack_q2_0_4x4(void * GGML_RESTRICT dst_v, const void * GGML_RESTRICT src_v, int64_t ne0, int64_t ne1) {
+    init_mmid_repack_luts();
+    const int64_t nb = ne0 / QK2_0;
+    const block_q2_0 * src = (const block_q2_0 *) src_v;
+    block_q2_0x4 * dst = (block_q2_0x4 *) dst_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        for (int64_t b = 0; b < nb; ++b) {
+            block_q2_0x4 out;
+            for (int i = 0; i < 4; ++i) {
+                const block_q2_0 & in = src[(r + i) * nb + b];
+                out.d[i] = in.d;
+                for (int k = 0; k < 2; ++k) {
+                    const uint8_t * s = in.qs + k * 8;
+                    uint32_t v0 = g_q2_0_lut[s[0]] | (g_q2_0_lut[s[1]] << 2) | (g_q2_0_lut[s[2]] << 4) | (g_q2_0_lut[s[3]] << 6);
