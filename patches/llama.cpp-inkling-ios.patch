+// File-mapping registry (sage-lab, inkling-phone): lets a backend turn a pointer into a memory-mapped model file
+// back into (fd, offset), to read ranges with pread instead of page faults. Registered by llama_mmap.
+#if defined(__APPLE__) || defined(__linux__)
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/uio.h>
+#include <unistd.h>
+#endif
+#define GGML_FILE_MAP_MAX 16
+static struct { const char * addr; size_t size; int fd; } ggml_file_maps[GGML_FILE_MAP_MAX];
+static int ggml_n_file_maps = 0;
+
+void ggml_file_map_register(const void * addr, size_t size, int fd) {
+    if (ggml_n_file_maps >= GGML_FILE_MAP_MAX) { return; }
+    int own = -1;
+#if defined(__APPLE__)
+    char path[1024];
+    if (fcntl(fd, F_GETPATH, path) == 0) {
+        own = open(path, O_RDONLY);
+        if (own >= 0) { fcntl(own, F_NOCACHE, 1); } // direct reads: keep the OS file cache out of the way
+    }
+#elif defined(__linux__)
+    own = dup(fd);
+#else
+    (void) fd;
+#endif
+    if (own < 0) { return; }
+    ggml_file_maps[ggml_n_file_maps].addr = (const char *) addr;
+    ggml_file_maps[ggml_n_file_maps].size = size;
+    ggml_file_maps[ggml_n_file_maps].fd   = own;
+    ggml_n_file_maps++;
+}
+
+bool ggml_file_map_read(const void * ptr, void * dst, size_t size) {
+#if defined(__APPLE__) || defined(__linux__)
+    const char * p = (const char *) ptr;
+    for (int i = 0; i < ggml_n_file_maps; i++) {
+        if (p >= ggml_file_maps[i].addr && p + size <= ggml_file_maps[i].addr + ggml_file_maps[i].size) {
+            size_t done = 0;
+            while (done < size) {
+                const ssize_t n = pread(ggml_file_maps[i].fd, (char *) dst + done, size - done, (off_t) (p - ggml_file_maps[i].addr) + done);
+                if (n <= 0) { return false; }
+                done += (size_t) n;
+            }
+            return true;
+        }
+    }
+#else
+    (void) ptr; (void) dst; (void) size;
+#endif
+    return false;
+}
+
+// adapted from Atomic Engine src/llama-expert-source.cpp (read_experts, adjacent layout): consecutive slices straight
+// into each destination with preadv; a short read advances the vectors and the offset
+bool ggml_file_map_readv(const void * ptr, void * const * dst, const size_t * size, int n) {
+#if defined(__APPLE__) || defined(__linux__)
+    if (n < 1 || n > 16) { return false; }
+    size_t total = 0;
+    struct iovec vectors[16];
+    for (int i = 0; i < n; i++) { vectors[i].iov_base = dst[i]; vectors[i].iov_len = size[i]; total += size[i]; }
+    const char * p = (const char *) ptr;
+    for (int m = 0; m < ggml_n_file_maps; m++) {
+        if (p >= ggml_file_maps[m].addr && p + total <= ggml_file_maps[m].addr + ggml_file_maps[m].size) {
+            off_t offset = (off_t) (p - ggml_file_maps[m].addr);
+            for (int i = 0; i < n;) {
+                const ssize_t bytes = preadv(ggml_file_maps[m].fd, vectors + i, n - i, offset);
+                if (bytes < 0 && errno == EINTR) { continue; }
+                if (bytes <= 0) { return false; }
+                offset += bytes;
+                size_t done = (size_t) bytes;
+                while (i < n && done >= vectors[i].iov_len) { done -= vectors[i].iov_len; ++i; }
+                if (i < n && done) {
+                    vectors[i].iov_base = (char *) vectors[i].iov_base + done;
+                    vectors[i].iov_len -= done;
+                }
+            }
+            return true;
+        }
+    }
+#else
+    (void) ptr; (void) dst; (void) size; (void) n;
+#endif
+    return false;
+}
+
+// expert matmul pairs (gate_up -> down), written at graph build, read by the CPU backend
+#define GGML_MMID_PAIR_MAX 64
+static struct {
+    const void * gate_up; const char * down; size_t down_nb2;
+    enum ggml_type down_type; int64_t down_ne0; int64_t down_ne1;
+} ggml_mmid_pairs[GGML_MMID_PAIR_MAX];
+static int ggml_n_mmid_pairs = 0;
+
+void ggml_mmid_register_pair(const struct ggml_tensor * gate_up, const struct ggml_tensor * down) {
+    if (!gate_up || !down || !gate_up->data || !down->data || gate_up->ne[2] != down->ne[2]) { return; }
+    for (int i = 0; i < ggml_n_mmid_pairs; i++) {
+        if (ggml_mmid_pairs[i].gate_up == gate_up->data) { return; }
+    }
+    if (ggml_n_mmid_pairs >= GGML_MMID_PAIR_MAX) { return; }
+    ggml_mmid_pairs[ggml_n_mmid_pairs].gate_up   = gate_up->data;
+    ggml_mmid_pairs[ggml_n_mmid_pairs].down      = (const char *) down->data;
+    ggml_mmid_pairs[ggml_n_mmid_pairs].down_nb2  = down->nb[2];
+    ggml_mmid_pairs[ggml_n_mmid_pairs].down_type = down->type;
+    ggml_mmid_pairs[ggml_n_mmid_pairs].down_ne0  = down->ne[0];
+    ggml_mmid_pairs[ggml_n_mmid_pairs].down_ne1  = down->ne[1];
+    ggml_n_mmid_pairs++;
+}
+
+bool ggml_mmid_get_pair(const void * gate_up_data, const char ** down_data, size_t * down_nb2) {
+    for (int i = 0; i < ggml_n_mmid_pairs; i++) {
+        if (ggml_mmid_pairs[i].gate_up == gate_up_data) {
+            *down_data = ggml_mmid_pairs[i].down; *down_nb2 = ggml_mmid_pairs[i].down_nb2;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool ggml_mmid_get_pair_meta(const void * gate_up_data, const char ** down_data, size_t * down_nb2,
+                             enum ggml_type * down_type, int64_t * down_ne0, int64_t * down_ne1) {
+    for (int i = 0; i < ggml_n_mmid_pairs; i++) {
+        if (ggml_mmid_pairs[i].gate_up == gate_up_data) {
+            *down_data = ggml_mmid_pairs[i].down; *down_nb2 = ggml_mmid_pairs[i].down_nb2;
+            *down_type = ggml_mmid_pairs[i].down_type; *down_ne0 = ggml_mmid_pairs[i].down_ne0; *down_ne1 = ggml_mmid_pairs[i].down_ne1;
+            return true;
+        }
+    }
+    return false;
+}
+
+#define GGML_MMID_ROUTER_MAX 128
+static struct {
+    const struct ggml_tensor * dst;
+    const char * gate_up;
+    size_t gate_up_nb2;
+} ggml_mmid_routers[GGML_MMID_ROUTER_MAX];
+static int ggml_mmid_router_head = 0;
+static int ggml_n_mmid_routers = 0;
+
+void ggml_mmid_register_router(const struct ggml_tensor * argsort_dst, const struct ggml_tensor * gate_up) {
+    if (!argsort_dst || !gate_up || !gate_up->data) { return; }
+    for (int i = 0; i < ggml_n_mmid_routers; i++) {
+        if (ggml_mmid_routers[i].dst == argsort_dst) {
+            ggml_mmid_routers[i].gate_up = (const char *) gate_up->data;
+            ggml_mmid_routers[i].gate_up_nb2 = gate_up->nb[2];
+            return;
+        }
+    }
+    int slot = ggml_n_mmid_routers < GGML_MMID_ROUTER_MAX ? ggml_n_mmid_routers++ : (ggml_mmid_router_head++ % GGML_MMID_ROUTER_MAX);
+    ggml_mmid_routers[slot].dst = argsort_dst;
+    ggml_mmid_routers[slot].gate_up = (const char *) gate_up->data;
+    ggml_mmid_routers[slot].gate_up_nb2 = gate_up->nb[2];
+}
+
+bool ggml_mmid_get_router(const struct ggml_tensor * argsort_dst, const char ** gate_up_data, size_t * gate_up_nb2) {
+    for (int i = 0; i < ggml_n_mmid_routers; i++) {
+        if (ggml_mmid_routers[i].dst == argsort_dst) {
+            *gate_up_data = ggml_mmid_routers[i].gate_up;
+            *gate_up_nb2 = ggml_mmid_routers[i].gate_up_nb2;
+            return true;
+        }
+    }
+    return false;
+}
