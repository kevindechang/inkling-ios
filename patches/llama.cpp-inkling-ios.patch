+void ggml_arm_gemv_iq1_s_4x4_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    const int nb = n / QK_K;
+    const block_iq1_sx4 * b_ptr = (const block_iq1_sx4 *) vx;
+    const block_q8_K * a_base = (const block_q8_K *) vy;
+    const uint8x16_t m3 = vdupq_n_u8(0x03);
+    for (int c = 0; c < nc; c += 4) {
+        float32x4_t acc = vdupq_n_f32(0.0f);
+        for (int b = 0; b < nb; ++b) {
+            const block_q8_K * ap = &a_base[b];
+            int32x4_t sumi = vdupq_n_s32(0);
+            int32x4_t sumi3 = vdupq_n_s32(0);
+            for (int ib = 0; ib < 8; ++ib) {
+                const int32_t bsum = (int32_t) ap->bsums[2 * ib] + (int32_t) ap->bsums[2 * ib + 1];
+                uint8x16_t b0 = vld1q_u8(b_ptr->qs + ib * 32 + 0);
+                uint8x16_t b1 = vld1q_u8(b_ptr->qs + ib * 32 + 16);
+                int8x16_t a0 = vld1q_s8(ap->qs + ib * 32 + 0);
+                int8x16_t a1 = vld1q_s8(ap->qs + ib * 32 + 16);
+                int32x4_t p = vdupq_n_s32(-bsum);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vandq_u8(b0, m3)),               a0, 0);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b0, 2), m3)), a0, 1);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b0, 4), m3)), a0, 2);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vshrq_n_u8(b0, 6)),               a0, 3);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vandq_u8(b1, m3)),               a1, 0);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b1, 2), m3)), a1, 1);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(b1, 4), m3)), a1, 2);
+                p = vdotq_laneq_s32(p, vreinterpretq_s8_u8(vshrq_n_u8(b1, 6)),               a1, 3);
+                int32x4_t ls_s = { b_ptr->ls_sgn[ib*4+0], b_ptr->ls_sgn[ib*4+1], b_ptr->ls_sgn[ib*4+2], b_ptr->ls_sgn[ib*4+3] };
+                int32x4_t ls_u = vabsq_s32(ls_s);
+                sumi  = vmlaq_s32(sumi, p, ls_u);
+                sumi3 = vmlaq_n_s32(sumi3, ls_s, bsum);
+            }
+            float32x4_t d = vmulq_n_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) b_ptr->d)), ap->d);
+            float32x4_t tot = vfmaq_n_f32(vcvtq_f32_s32(sumi), vcvtq_f32_s32(sumi3), IQ1S_DELTA);
+            acc = vfmaq_f32(acc, d, tot);
+            b_ptr++;
+        }
+        vst1q_f32(s + c, acc);
+    }
+}
