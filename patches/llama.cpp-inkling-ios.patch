+GGML_BACKEND_API void ggml_mmid_repack_slice(enum ggml_type type, int64_t ne0, int64_t ne1, void * dst, const void * src, size_t src_size) {
+    struct ggml_tensor t;
+    memset(&t, 0, sizeof(t));
+    t.type = type;
+    t.ne[0] = ne0; t.ne[1] = ne1; t.ne[2] = 1; t.ne[3] = 1;
+    t.data = dst;
+    const int inter = ggml_cpu_has_matmul_int8() ? 8 : 4;
+    switch (type) {
+        case GGML_TYPE_MXFP4:   repack_mxfp4_to_mxfp4_4_bl(&t, 4, src, src_size); break;
+        case GGML_TYPE_Q4_0:    repack_q4_0_to_q4_0_4_bl(&t, inter, src, src_size); break;
+        case GGML_TYPE_IQ4_NL:  repack_iq4_nl_to_iq4_nl_4_bl(&t, 4, src, src_size); break;
+        case GGML_TYPE_Q8_0:    repack_q8_0_to_q8_0_4_bl(&t, inter, src, src_size); break;
+        case GGML_TYPE_Q1_0:    repack_q1_0_to_q1_0_4_bl(&t, inter, src, src_size); break;
+        case GGML_TYPE_Q4_K:    repack_q4_K_to_q4_K_8_bl(&t, inter, src, src_size); break;
+        case GGML_TYPE_Q5_K:    repack_q5_K_to_q5_K_8_bl(&t, inter, src, src_size); break;
+        case GGML_TYPE_Q6_K:    repack_q6_K_to_q6_K_8_bl(&t, inter, src, src_size); break;
+        case GGML_TYPE_Q2_0:    ggml_arm_repack_q2_0_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_NVFP4:   ggml_arm_repack_nvfp4_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_Q2_K:    ggml_arm_repack_q2_K_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_IQ1_S:   ggml_arm_repack_iq1_s_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_IQ2_S:   ggml_arm_repack_iq2_s_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_IQ2_XS:  ggml_arm_repack_iq2_xs_4x4(dst, src, ne0, ne1); break;
+        case GGML_TYPE_IQ2_XXS: ggml_arm_repack_iq2_xxs_4x4(dst, src, ne0, ne1); break;
+        default: GGML_ABORT("unsupported ggml_mmid_repack_slice type %d", (int) type);
