+GGML_BACKEND_API void ggml_cpu_mmid_stats_reset(void);
+void ggml_cpu_mmid_stats_reset(void) {
+    mmid_wait_us = 0;
+    mmid_pf_issued = 0;
+    mmid_pf_used = 0;
+    mmid_pf_wasted = 0;
+    mmid_bypass_reads = 0;
+    atomic_store(&mmid_read_bytes, 0);
+    atomic_store(&mmid_read_calls, 0);
+    atomic_store(&mmid_repacked_slices, 0);
+    atomic_store(&mmid_repack_us, 0);
+    atomic_store(&mmid_cecar_calls, 0);
+    atomic_store(&mmid_cecar_swaps, 0);
