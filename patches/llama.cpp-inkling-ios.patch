+void ggml_arm_repack_q2_K_4x4(void * GGML_RESTRICT dst_v, const void * GGML_RESTRICT src_v, int64_t ne0, int64_t ne1) {
+    const int64_t nb = ne0 / QK_K;
+    const block_q2_K * src = (const block_q2_K *) src_v;
+    block_q2_Kx4 * dst = (block_q2_Kx4 *) dst_v;
+    for (int64_t r = 0; r < ne1; r += 4) {
+        const block_q2_K * s0 = src + (r + 0) * nb;
+        const block_q2_K * s1 = src + (r + 1) * nb;
+        const block_q2_K * s2 = src + (r + 2) * nb;
+        const block_q2_K * s3 = src + (r + 3) * nb;
+        for (int64_t b = 0; b < nb; ++b) {
+            dst->d[0]    = s0[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+            dst->d[1]    = s1[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+            dst->d[2]    = s2[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+            dst->d[3]    = s3[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.d;
+            dst->dmin[0] = s0[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+            dst->dmin[1] = s1[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+            dst->dmin[2] = s2[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+            dst->dmin[3] = s3[b].GGML_COMMON_AGGR_U.GGML_COMMON_AGGR_S.dmin;
+            uint8x16x4_t sc;
+            sc.val[0] = vld1q_u8(s0[b].scales);
+            sc.val[1] = vld1q_u8(s1[b].scales);
+            sc.val[2] = vld1q_u8(s2[b].scales);
+            sc.val[3] = vld1q_u8(s3[b].scales);
+            vst4q_u8(dst->scales, sc);
+            for (int c = 0; c < 4; ++c) {
+                uint32x4x4_t qv;
+                qv.val[0] = vreinterpretq_u32_u8(vld1q_u8(s0[b].qs + c * 16));
+                qv.val[1] = vreinterpretq_u32_u8(vld1q_u8(s1[b].qs + c * 16));
+                qv.val[2] = vreinterpretq_u32_u8(vld1q_u8(s2[b].qs + c * 16));
+                qv.val[3] = vreinterpretq_u32_u8(vld1q_u8(s3[b].qs + c * 16));
+                vst4q_u32((uint32_t *) (dst->qs + c * 64), qv);
+            }
+            ++dst;
+        }
+    }
