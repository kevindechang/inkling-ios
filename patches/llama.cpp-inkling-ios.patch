+// GGML_CPU_PERSIST_POOL=1 (sage-lab, runs/speed/THREAD_SCALING.md): with no threadpool attached, keep one pool alive
+// across graphs instead of creating and joining a disposable pool (new threads) for every graph. GGML_CPU_POLL=<0..100>
+// sets its polling level (ggml default 50). Off by default.
+static bool ggml_backend_cpu_persist_pool(void) {
+    static int state = -1;
+    if (state < 0) { const char * v = getenv("GGML_CPU_PERSIST_POOL"); state = v && atoi(v) == 1; }
+    return state == 1;
+}
+
+static ggml_threadpool_t ggml_backend_cpu_get_own_pool(struct ggml_backend_cpu_context * ctx) {
+    if (ctx->own_pool && ctx->own_pool_n == ctx->n_threads) {
+        return ctx->own_pool;
+    }
+    if (ctx->own_pool) {
+        ggml_threadpool_free(ctx->own_pool);
+        ctx->own_pool = NULL;
+    }
+    struct ggml_threadpool_params tpp = ggml_threadpool_params_default(ctx->n_threads);
+    const char * poll = getenv("GGML_CPU_POLL");
+    if (poll) { tpp.poll = (uint32_t) atoi(poll); }
+    ctx->own_pool   = ggml_threadpool_new(&tpp);
+    ctx->own_pool_n = ctx->own_pool ? ctx->n_threads : 0;
+    return ctx->own_pool;
+}
