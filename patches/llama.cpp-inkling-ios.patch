+                const int8x16_t w01 = vreinterpretq_s8_u8(vandq_u8(b0, m3)); b0 = vshrq_n_u8(b0, 2);
+                const int8x16_t w02 = vreinterpretq_s8_u8(vandq_u8(b0, m3));
+                const int8x16_t w03 = vreinterpretq_s8_u8(vshrq_n_u8(b0, 2));
