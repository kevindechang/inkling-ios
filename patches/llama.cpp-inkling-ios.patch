+
+GGML_BACKEND_API void ggml_cpu_mmid_stats_dump(void);
+void ggml_cpu_mmid_stats_dump(void) {
+    if (!mmid_stats_on) return;
+    mmid_stats_on = 0;
+    fprintf(stderr, "[mmid] overlap=%d lru=%d coalesce=%d repack=%d budget_mb=%zu hits=%llu misses=%llu read_mb=%.1f read_calls=%llu wait_ms=%.1f "
+        "prefetch_issued=%llu prefetch_used=%llu prefetch_wasted=%llu bypass_reads=%llu repacked=%llu repack_ms=%.1f cecar_bonus=%.4f cecar_calls=%llu cecar_swaps=%llu\n",
