+// Exact inverses of the mmid repack layouts. src and dst must not overlap.
+// Q2_K / Q2_0 match ggml_arm_repack_*_4x4. Q4_0 / Q4_K use the same interleave
+// width as ggml_mmid_repack_slice (8 on i8mm, 4 otherwise). IQ4_NL is 4x4.
+
+static void mmid_unpack_q4k_12(const uint8_t * p, uint8_t s[8], uint8_t m[8]) {
+    s[0] = p[0] & 63; s[1] = p[1] & 63; s[2] = p[2] & 63; s[3] = p[3] & 63;
+    m[0] = p[4] & 63; m[1] = p[5] & 63; m[2] = p[6] & 63; m[3] = p[7] & 63;
+    s[4] = (uint8_t) ((p[8]  & 15) | (((p[0] >> 6) & 3) << 4));
+    s[5] = (uint8_t) ((p[9]  & 15) | (((p[1] >> 6) & 3) << 4));
+    s[6] = (uint8_t) ((p[10] & 15) | (((p[2] >> 6) & 3) << 4));
+    s[7] = (uint8_t) ((p[11] & 15) | (((p[3] >> 6) & 3) << 4));
+    m[4] = (uint8_t) (((p[8]  >> 4) & 15) | (((p[4] >> 6) & 3) << 4));
+    m[5] = (uint8_t) (((p[9]  >> 4) & 15) | (((p[5] >> 6) & 3) << 4));
+    m[6] = (uint8_t) (((p[10] >> 4) & 15) | (((p[6] >> 6) & 3) << 4));
+    m[7] = (uint8_t) (((p[11] >> 4) & 15) | (((p[7] >> 6) & 3) << 4));
+}
