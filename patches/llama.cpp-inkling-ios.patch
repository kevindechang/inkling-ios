+        if (n_io < 1 || n_io > MMID_IO_THREADS_MAX) { n_io = MMID_IO_THREADS; }
+        for (int i = 0; i < n_io; i++) {
+            if (pthread_create(&mmid_io.threads[i], &attr, mmid_io_main, NULL) != 0) { break; }
+            mmid_io.n_threads++;
+        }
+        pthread_attr_destroy(&attr);
+        if (mmid_io.n_threads == 0) { mmid_overlap = 0; fprintf(stderr, "%s: no reader threads, GGML_MMID_OVERLAP off\n", __func__); }
+    }
+    if (mmid_overlap || mmid_stats_on) { atexit(mmid_port_exit); }
+}
